<%
  const passCategoryStats = profileCategoryStats?.pass || [];
  const wristbandCategoryStats = profileCategoryStats?.wristband || [];
  const tr = (key, fallback, params) => {
    const value = t(key, params);
    return value === key ? fallback : value;
  };
  const qrJsonEscapeMap = {
    '<': '\\u003c',
    '>': '\\u003e',
    '&': '\\u0026',
    '\u2028': '\\u2028',
    '\u2029': '\\u2029',
  };
  const requestProfileQrJson = JSON.stringify(Object.fromEntries(profiles.map((profile) => [
    String(profile.id),
    {
      name: profile.name || '',
      inviteUrl: profile.invite_url || '',
      qrSrc: profile.invite_qr_data_url || '',
    },
  ]))).replace(/[<>&\u2028\u2029]/g, (char) => qrJsonEscapeMap[char]);
%>
<section class="request-profile-page request-profile-page--list space-y-6">
  <section class="shell-card request-profile-table-card">
    <div class="request-profile-table-card__head">
      <div>
        <p class="request-profile-table-card__eyebrow"><%= t('requestProfiles.nav.list') %></p>
        <h1><%= t('requestProfiles.listTitle') %> (<%= profiles.length %>)</h1>
        <p><%= t('requestProfiles.listDescription') %></p>
      </div>

      <div class="request-profile-table-card__actions">
        <a href="/events/<%= activeEvent.id %>/request-profiles/applications" class="btn-secondary">
          <span><%= t('requestProfileApplications.adminButton', { count: pendingApplicationCount || 0 }) %></span>
        </a>

        <button type="button" class="btn-secondary request-profile-statistics-button" data-request-profile-statistics-open>
          <svg viewBox="0 0 20 20" aria-hidden="true">
            <path d="M4 16V9"></path>
            <path d="M10 16V4"></path>
            <path d="M16 16v-6"></path>
          </svg>
          <span><%= t('requestProfiles.statistics.button') %></span>
        </button>

        <div class="request-profile-application-link-group" role="group" aria-label="<%= t('requestProfileApplications.publicLinkActions') %>">
          <a href="<%= profileApplicationUrl %>" target="_blank" rel="noreferrer" class="btn-secondary request-profile-application-link-group__open">
            <span><%= t('requestProfileApplications.openPublicLink') %></span>
          </a>

          <button
            type="button"
            class="btn-secondary request-profile-application-link-group__copy"
            data-copy-text="<%= profileApplicationUrl %>"
            data-copy-success-message="<%= t('requestProfileApplications.copySuccess') %>"
            data-tooltip="<%= t('requestProfileApplications.copyPublicLink') %>"
            aria-label="<%= t('requestProfileApplications.copyPublicLink') %>"
          >
            <svg viewBox="0 0 20 20" aria-hidden="true">
              <path d="M7 3.5A2.5 2.5 0 0 1 9.5 1h6A2.5 2.5 0 0 1 18 3.5v6A2.5 2.5 0 0 1 15.5 12h-6A2.5 2.5 0 0 1 7 9.5zM4.5 6A2.5 2.5 0 0 0 2 8.5v6A2.5 2.5 0 0 0 4.5 17h6A2.5 2.5 0 0 0 13 14.5V14" />
            </svg>
          </button>
        </div>

        <div class="request-profile-search">
          <svg viewBox="0 0 20 20" aria-hidden="true">
            <path d="M8.5 3a5.5 5.5 0 1 1 0 11 5.5 5.5 0 0 1 0-11Zm0 1.6a3.9 3.9 0 1 0 0 7.8 3.9 3.9 0 0 0 0-7.8Zm5.38 8.64 3.02 3.02-1.13 1.13-3.02-3.02z" />
          </svg>
          <input
            type="search"
            class="field-input"
            placeholder="<%= t('requestProfiles.searchPlaceholder') %>"
            data-request-profile-search
          />
        </div>

        <a href="/events/<%= activeEvent.id %>/request-profiles/new" class="btn-primary">
          <img src="/public/design-assets/icons/feather/plus.svg" alt="" class="h-4 w-4 brightness-0 invert" />
          <span><%= t('requestProfiles.createButton') %></span>
        </a>
      </div>
    </div>

    <div class="request-profile-table-scroll">
      <table class="request-profile-table">
        <thead>
          <tr>
            <th><%= t('requestProfiles.table.profile') %></th>
            <th><%= t('requestProfiles.table.code') %></th>
            <th><%= t('requestProfiles.table.wristbands') %></th>
            <th><%= t('requestProfiles.table.passes') %></th>
            <th><%= t('requestProfiles.table.link') %></th>
            <th><%= t('requestProfiles.table.status') %></th>
            <th><%= t('requestProfiles.table.actions') %></th>
          </tr>
        </thead>
        <tbody data-request-profile-table-body>
          <% if (!profiles.length) { %>
            <tr data-request-profile-empty-row>
              <td colspan="7">
                <div class="request-profile-empty"><%= t('requestProfiles.none') %></div>
              </td>
            </tr>
          <% } %>

          <% profiles.forEach((profile) => { %>
            <tr
              data-request-profile-row
              data-search-index="<%= [profile.name, profile.access_code, profile.notes || '', profile.invite_url, profile.is_unlimited_quota ? t('requestProfiles.unlimited') : `${profile.wristbandTotals.used}/${profile.wristbandTotals.quota}`, profile.is_unlimited_quota ? t('requestProfiles.unlimited') : `${profile.passTotals.used}/${profile.passTotals.quota}`, profile.is_active ? t('common.active') : t('common.inactive')].join(' ').toLowerCase() %>"
            >
              <td>
                <div class="request-profile-cell">
                  <p class="request-profile-cell__title"><%= profile.name %></p>
                  <p class="request-profile-cell__meta"><%= profile.notes || t('common.noDescription') %></p>
                </div>
              </td>
              <td>
                <div class="request-profile-code-pill"><%= profile.access_code || '----' %></div>
              </td>
              <td>
                <div class="request-profile-quota-metric">
                  <% if (profile.is_unlimited_quota) { %>
                    <strong><%= profile.wristbandTotals.used %></strong>
                    <span><%= t('requestProfiles.unlimited') %></span>
                  <% } else { %>
                    <strong><%= profile.wristbandTotals.used %>/<%= profile.wristbandTotals.quota %></strong>
                    <span><%= t('requestProfiles.remaining', { count: profile.wristbandTotals.remaining }) %></span>
                  <% } %>
                </div>
              </td>
              <td>
                <div class="request-profile-quota-metric">
                  <% if (profile.is_unlimited_quota) { %>
                    <strong><%= profile.passTotals.used %></strong>
                    <span><%= t('requestProfiles.unlimited') %></span>
                  <% } else { %>
                    <strong><%= profile.passTotals.used %>/<%= profile.passTotals.quota %></strong>
                    <span><%= t('requestProfiles.remaining', { count: profile.passTotals.remaining }) %></span>
                  <% } %>
                </div>
              </td>
              <td>
                <div class="request-profile-link-cell">
                  <a href="<%= profile.invite_url %>" target="_blank" rel="noreferrer"><%= `/p/${profile.access_code}` %></a>
                </div>
              </td>
              <td>
                <span class="status-<%= profile.is_active ? 'active' : 'archived' %>"><%= profile.is_active ? t('common.active') : t('common.inactive') %></span>
              </td>
              <td>
                <div class="request-profile-actions">
                  <a
                    href="/events/<%= activeEvent.id %>/request-profiles/<%= profile.id %>/edit"
                    class="table-icon-button"
                    data-tooltip="<%= t('requestProfiles.editProfile') %>"
                    aria-label="<%= t('requestProfiles.editProfile') %>"
                  >
                    <svg viewBox="0 0 20 20" aria-hidden="true">
                      <path d="M13.85 2.85a1.8 1.8 0 0 1 2.55 2.55l-8.1 8.1-3.38.83.84-3.38zm1.42 1.13-1.7-1.7" />
                    </svg>
                  </a>

                  <form
                    action="/events/<%= activeEvent.id %>/request-profiles/<%= profile.id %>/send-invite"
                    method="POST"
                    class="request-profile-action-form"
                  >
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                    <button
                      type="submit"
                      class="table-icon-button"
                      data-tooltip="<%= profile.contact_email ? t('requestProfiles.sendInviteEmail') : t('requestProfiles.sendInviteEmailMissing') %>"
                      aria-label="<%= profile.contact_email ? t('requestProfiles.sendInviteEmail') : t('requestProfiles.sendInviteEmailMissing') %>"
                      <%= profile.contact_email ? '' : 'disabled' %>
                    >
                      <svg viewBox="0 0 20 20" aria-hidden="true">
                        <path d="M3.5 5.5h13v9h-13z" />
                        <path d="m4 6 6 5 6-5" />
                      </svg>
                    </button>
                  </form>

                  <button
                    type="button"
                    class="table-icon-button"
                    data-request-profile-qr-open
                    data-request-profile-id="<%= profile.id %>"
                    data-request-profile-name="<%= profile.name %>"
                    data-request-profile-invite-url="<%= profile.invite_url %>"
                    data-tooltip="<%= tr('requestProfiles.showQr', 'Rādīt QR kodu') %>"
                    aria-label="<%= tr('requestProfiles.showQr', 'Rādīt QR kodu') %>"
                  >
                    <svg viewBox="0 0 20 20" aria-hidden="true">
                      <path d="M3 3h5v5H3zM12 3h5v5h-5zM3 12h5v5H3z" />
                      <path d="M12 12h2v2h-2zM15 12h2v5h-2zM12 15h2v2h-2z" />
                    </svg>
                  </button>

                  <button
                    type="button"
                    class="table-icon-button"
                    data-copy-text="<%= profile.invite_url %>"
                    data-copy-success-message="<%= t('requestProfiles.copySuccess') %>"
                    data-tooltip="<%= t('requestProfiles.copyInviteLink') %>"
                    aria-label="<%= t('requestProfiles.copyInviteLink') %>"
                  >
                    <svg viewBox="0 0 20 20" aria-hidden="true">
                      <path d="M7 3.5A2.5 2.5 0 0 1 9.5 1h6A2.5 2.5 0 0 1 18 3.5v6A2.5 2.5 0 0 1 15.5 12h-6A2.5 2.5 0 0 1 7 9.5zM4.5 6A2.5 2.5 0 0 0 2 8.5v6A2.5 2.5 0 0 0 4.5 17h6A2.5 2.5 0 0 0 13 14.5V14" />
                    </svg>
                  </button>

                  <a
                    href="<%= profile.invite_url %>"
                    target="_blank"
                    rel="noreferrer"
                    class="table-icon-button"
                    data-tooltip="<%= t('requestProfiles.openInviteLink') %>"
                    aria-label="<%= t('requestProfiles.openInviteLink') %>"
                  >
                    <svg viewBox="0 0 20 20" aria-hidden="true">
                      <path d="M11 3h6v6M10 10l7-7M16 11v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h4" />
                    </svg>
                  </a>
                </div>
              </td>
            </tr>
          <% }) %>

          <tr class="hidden" data-request-profile-empty-row>
            <td colspan="7">
              <div class="request-profile-empty"><%= t('requestProfiles.emptySearch') %></div>
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>

  <script type="application/json" data-request-profile-qr-data><%- requestProfileQrJson %></script>

  <div class="portal-modal request-profile-qr-modal" data-request-profile-qr-modal>
    <button type="button" class="portal-modal__backdrop" data-request-profile-qr-close></button>
    <div class="portal-modal__dialog shell-card" role="dialog" aria-modal="true" aria-labelledby="request-profile-qr-title">
      <div class="portal-modal__header">
        <div class="portal-modal__title-block">
          <p class="worldnic-eyebrow"><%= tr('requestProfiles.qrEyebrow', 'Profila QR') %></p>
          <h2 id="request-profile-qr-title" data-request-profile-qr-title><%= tr('requestProfiles.qrTitle', 'Profila piekļuves QR') %></h2>
        </div>
        <button
          type="button"
          class="table-icon-button"
          data-request-profile-qr-close
          data-tooltip="<%= tr('requestProfiles.qrClose', 'Aizvērt QR kodu') %>"
          aria-label="<%= tr('requestProfiles.qrClose', 'Aizvērt QR kodu') %>"
        >
          <svg viewBox="0 0 20 20" aria-hidden="true">
            <path d="M5 5l10 10M15 5 5 15"></path>
          </svg>
        </button>
      </div>

      <div class="request-profile-qr-shell">
        <p><%= tr('requestProfiles.qrDescription', 'Noskenē šo QR kodu, lai atvērtu tiešo profila ielūguma linku.') %></p>
        <div class="request-profile-qr-code" data-request-profile-qr-code>
          <img src="" alt="<%= tr('requestProfiles.qrAlt', 'QR kods profila ielūguma linkam') %>" data-request-profile-qr-image />
        </div>
        <a href="#" target="_blank" rel="noreferrer" class="request-profile-qr-link" data-request-profile-qr-link></a>
        <button
          type="button"
          class="btn-secondary"
          data-request-profile-qr-copy
          data-copy-text=""
          data-copy-success-message="<%= t('requestProfiles.copySuccess') %>"
        >
          <%= t('requestProfiles.copyInviteLink') %>
        </button>
      </div>
    </div>
  </div>

  <div class="portal-modal request-profile-statistics-modal" data-request-profile-statistics-modal>
    <button type="button" class="portal-modal__backdrop" data-request-profile-statistics-close></button>
    <div class="portal-modal__dialog portal-modal__dialog-wide shell-card" role="dialog" aria-modal="true" aria-labelledby="request-profile-statistics-title">
      <div class="portal-modal__header">
        <div class="portal-modal__title-block">
          <p class="worldnic-eyebrow"><%= t('requestProfiles.statistics.eyebrow') %></p>
          <h2 id="request-profile-statistics-title"><%= t('requestProfiles.statistics.title') %></h2>
        </div>
        <button
          type="button"
          class="table-icon-button"
          data-request-profile-statistics-close
          data-tooltip="<%= t('requestProfiles.statistics.close') %>"
          aria-label="<%= t('requestProfiles.statistics.close') %>"
        >
          <svg viewBox="0 0 20 20" aria-hidden="true">
            <path d="M5 5l10 10M15 5 5 15"></path>
          </svg>
        </button>
      </div>

      <div class="request-profile-statistics-shell">
        <p><%= t('requestProfiles.statistics.description') %></p>

        <div class="request-profile-statistics-grid">
          <section class="request-profile-statistics-panel">
            <div class="request-profile-statistics-panel__head">
              <div>
                <p><%= t('requestProfiles.statistics.passes') %></p>
                <span><%= t('requestProfiles.statistics.sectionHint') %></span>
              </div>
            </div>

            <% if (passCategoryStats.length) { %>
              <div class="request-profile-statistics-list">
                <% passCategoryStats.forEach((stat) => { %>
                  <div class="request-profile-statistics-row">
                    <strong><%= stat.name %></strong>
                    <span>
                      <b><%= stat.requested %></b>
                      <small><%= t('requestProfiles.statistics.requested') %></small>
                    </span>
                    <span>
                      <b><%= stat.assigned %></b>
                      <small><%= t('requestProfiles.statistics.assigned') %></small>
                    </span>
                  </div>
                <% }) %>
              </div>
            <% } else { %>
              <div class="request-profile-statistics-empty"><%= t('requestProfiles.statistics.empty') %></div>
            <% } %>
          </section>

          <section class="request-profile-statistics-panel">
            <div class="request-profile-statistics-panel__head">
              <div>
                <p><%= t('requestProfiles.statistics.wristbands') %></p>
                <span><%= t('requestProfiles.statistics.sectionHint') %></span>
              </div>
            </div>

            <% if (wristbandCategoryStats.length) { %>
              <div class="request-profile-statistics-list">
                <% wristbandCategoryStats.forEach((stat) => { %>
                  <div class="request-profile-statistics-row">
                    <strong><%= stat.name %></strong>
                    <span>
                      <b><%= stat.requested %></b>
                      <small><%= t('requestProfiles.statistics.requested') %></small>
                    </span>
                    <span>
                      <b><%= stat.assigned %></b>
                      <small><%= t('requestProfiles.statistics.assigned') %></small>
                    </span>
                  </div>
                <% }) %>
              </div>
            <% } else { %>
              <div class="request-profile-statistics-empty"><%= t('requestProfiles.statistics.empty') %></div>
            <% } %>
          </section>
        </div>
      </div>
    </div>
  </div>
</section>
