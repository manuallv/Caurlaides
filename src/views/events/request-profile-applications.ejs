<section class="request-profile-page request-profile-page--list space-y-6">
  <section class="shell-card request-profile-table-card request-profile-applications-card">
    <div class="request-profile-table-card__head">
      <div>
        <p class="request-profile-table-card__eyebrow"><%= t('requestProfileApplications.adminEyebrow') %></p>
        <h1><%= t('requestProfileApplications.adminTitle', { count: pendingApplicationCount || 0 }) %></h1>
        <p><%= t('requestProfileApplications.adminDescription') %></p>
      </div>

      <div class="request-profile-table-card__actions">
        <a href="/events/<%= activeEvent.id %>/request-profiles" class="btn-secondary">
          <span><%= t('requestProfiles.nav.list') %></span>
        </a>

        <div class="request-profile-application-link-group" role="group" aria-label="<%= t('requestProfileApplications.publicLinkActions') %>">
          <a href="<%= profileApplicationUrl %>" target="_blank" rel="noreferrer" class="btn-secondary request-profile-application-link-group__open">
            <span><%= t('requestProfileApplications.openPublicLink') %></span>
          </a>

          <button
            type="button"
            class="btn-secondary request-profile-application-link-group__copy"
            data-copy-text="<%= profileApplicationUrl %>"
            data-copy-success-message="<%= t('requestProfileApplications.copySuccess') %>"
            title="<%= t('requestProfileApplications.copyPublicLink') %>"
            aria-label="<%= t('requestProfileApplications.copyPublicLink') %>"
          >
            <svg viewBox="0 0 20 20" aria-hidden="true">
              <path d="M7 3.5A2.5 2.5 0 0 1 9.5 1h6A2.5 2.5 0 0 1 18 3.5v6A2.5 2.5 0 0 1 15.5 12h-6A2.5 2.5 0 0 1 7 9.5zM4.5 6A2.5 2.5 0 0 0 2 8.5v6A2.5 2.5 0 0 0 4.5 17h6A2.5 2.5 0 0 0 13 14.5V14" />
            </svg>
          </button>
        </div>
      </div>
    </div>

    <% if (!profileApplications.length) { %>
      <div class="request-profile-applications-empty">
        <%= t('requestProfileApplications.empty') %>
      </div>
    <% } else { %>
      <div class="request-profile-application-toolbar">
        <div class="request-profile-search request-profile-application-search">
          <svg viewBox="0 0 20 20" aria-hidden="true">
            <path d="M8.5 3a5.5 5.5 0 1 1 0 11 5.5 5.5 0 0 1 0-11Zm0 1.6a3.9 3.9 0 1 0 0 7.8 3.9 3.9 0 0 0 0-7.8Zm5.38 8.64 3.02 3.02-1.13 1.13-3.02-3.02z" />
          </svg>
          <input
            type="search"
            class="field-input"
            placeholder="<%= t('requestProfileApplications.searchPlaceholder') %>"
            aria-label="<%= t('requestProfileApplications.searchPlaceholder') %>"
            data-request-profile-application-search
          />
        </div>
      </div>

      <div class="request-profile-applications-empty hidden" data-request-profile-application-search-empty>
        <%= t('requestProfileApplications.emptySearch') %>
      </div>

      <div class="request-profile-application-list" data-request-profile-application-list>
        <% profileApplications.forEach((application) => { %>
          <% const applicationSearchIndex = [
            application.profile_name,
            application.contact_email,
            application.contact_phone,
            String(application.contact_phone || '').replace(/\D/g, ''),
            t(`requestProfileApplications.status.${application.status}`),
            helpers.formatDateTime(application.created_at),
            application.approved_access_code,
            application.notes,
            application.rejection_reason,
            ...application.requestedPassSummary.map((entry) => `${entry.categoryName} ${entry.quota}`),
            ...application.requestedWristbandSummary.map((entry) => `${entry.categoryName} ${entry.quota}`),
          ].filter(Boolean).join(' ').toLowerCase(); %>
          <article
            class="request-profile-application-card request-profile-application-card--<%= application.status %>"
            data-request-profile-application-card
            data-search-index="<%= applicationSearchIndex %>"
          >
            <div class="request-profile-application-card__head">
              <div>
                <span class="request-profile-application-status request-profile-application-status--<%= application.status %>">
                  <%= t(`requestProfileApplications.status.${application.status}`) %>
                </span>
                <h3><%= application.profile_name %></h3>
                <p>
                  <%= application.contact_email %>
                  <% if (application.contact_phone) { %>
                    · <%= application.contact_phone %>
                  <% } %>
                </p>
                <p><%= t('requestProfileApplications.submittedAt', { time: helpers.formatDateTime(application.created_at) }) %></p>
              </div>

              <% if (application.approved_access_code) { %>
                <div class="request-profile-code-pill"><%= application.approved_access_code %></div>
              <% } %>
            </div>

            <% if (application.notes) { %>
              <p class="request-profile-application-card__notes"><%= application.notes %></p>
            <% } %>

            <div class="request-profile-application-quota-text">
              <p class="request-profile-application-quota-line">
                <strong><%= t('requestProfiles.sections.passTitle') %>:</strong>
                <span class="request-profile-application-quota-chips">
                  <% if (application.requestedPassSummary.length) { %>
                    <% application.requestedPassSummary.forEach((entry) => { %>
                      <span class="request-profile-application-quota-chip">
                        <span class="request-profile-application-quota-name"><%= entry.categoryName %></span>
                        <span class="request-profile-application-quota-count"><%= entry.quota %></span>
                      </span>
                    <% }) %>
                  <% } else { %>
                    <span class="request-profile-application-quota-empty">0</span>
                  <% } %>
                </span>
              </p>
              <p class="request-profile-application-quota-line">
                <strong><%= t('requestProfiles.sections.wristbandTitle') %>:</strong>
                <span class="request-profile-application-quota-chips">
                  <% if (application.requestedWristbandSummary.length) { %>
                    <% application.requestedWristbandSummary.forEach((entry) => { %>
                      <span class="request-profile-application-quota-chip">
                        <span class="request-profile-application-quota-name"><%= entry.categoryName %></span>
                        <span class="request-profile-application-quota-count"><%= entry.quota %></span>
                      </span>
                    <% }) %>
                  <% } else { %>
                    <span class="request-profile-application-quota-empty">0</span>
                  <% } %>
                </span>
              </p>
              <% if (application.rejection_reason) { %>
                <p>
                  <strong><%= t('requestProfileApplications.rejectReason') %>:</strong>
                  <span><%= application.rejection_reason %></span>
                </p>
              <% } %>
            </div>

            <% if (application.status === 'pending') { %>
              <div class="request-profile-application-actions request-profile-application-actions--primary">
                <form
                  action="/events/<%= activeEvent.id %>/request-profile-applications/<%= application.id %>/approve"
                  method="POST"
                  class="request-profile-application-approve-form"
                >
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                  <% passCategories.forEach((category) => { %>
                    <input type="hidden" name="passQuota[category_<%= category.id %>]" value="<%= application.requestedPassQuotaMap[Number(category.id)] || 0 %>" />
                  <% }) %>
                  <% wristbandCategories.forEach((category) => { %>
                    <input type="hidden" name="wristbandQuota[category_<%= category.id %>]" value="<%= application.requestedWristbandQuotaMap[Number(category.id)] || 0 %>" />
                  <% }) %>
                  <label class="request-profile-toggle request-profile-application-duplicate-toggle">
                    <input type="checkbox" name="allowDuplicateVehiclePlates" />
                    <span><%= t('requestProfiles.fields.allowDuplicateVehiclePlates') %></span>
                  </label>
                  <button type="submit" class="btn-primary"><%= t('requestProfileApplications.approve') %></button>
                </form>

                <form action="/events/<%= activeEvent.id %>/request-profile-applications/<%= application.id %>/reject" method="POST">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                  <button type="submit" class="btn-secondary"><%= t('requestProfileApplications.reject') %></button>
                </form>

                <details class="request-profile-application-edit">
                  <summary class="btn-secondary"><%= t('requestProfileApplications.edit') %></summary>

                  <form
                    action="/events/<%= activeEvent.id %>/request-profile-applications/<%= application.id %>/approve"
                    method="POST"
                    class="request-profile-application-form"
                    data-request-profile-form
                    data-request-profile-quota-required-message="<%= t('service.requestProfileApplication.quotaRequired') %>"
                  >
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

                    <section class="request-profile-application-form__profile shell-card">
                      <div class="request-profile-quota-card__head">
                        <h2><%= t('requestProfileApplications.editProfileTitle') %></h2>
                      </div>

                      <div class="request-profile-application-form__fields">
                        <label class="field-label">
                          <span><%= t('requestProfiles.fields.name') %></span>
                          <input
                            type="text"
                            name="profileName"
                            class="field-input"
                            value="<%= application.profile_name %>"
                            required
                          />
                        </label>

                        <label class="field-label">
                          <span><%= t('profileApplication.email') %></span>
                          <input
                            type="email"
                            name="contactEmail"
                            class="field-input"
                            value="<%= application.contact_email %>"
                            required
                          />
                        </label>

                        <label class="field-label">
                          <span><%= t('profileApplication.phone') %></span>
                          <input
                            type="text"
                            name="contactPhone"
                            class="field-input"
                            value="<%= application.contact_phone %>"
                            required
                          />
                        </label>

                        <label class="field-label request-profile-application-form__full">
                          <span><%= t('requestProfiles.fields.notes') %></span>
                          <textarea
                            name="notes"
                            rows="3"
                            class="field-input"
                            placeholder="<%= t('requestProfileApplications.notesPlaceholder') %>"
                          ><%= application.notes || '' %></textarea>
                        </label>

                        <label class="request-profile-toggle request-profile-toggle--wide request-profile-application-form__full">
                          <input type="checkbox" name="allowDuplicateVehiclePlates" />
                          <span>
                            <strong><%= t('requestProfiles.fields.allowDuplicateVehiclePlates') %></strong>
                            <small><%= t('requestProfiles.fields.allowDuplicateVehiclePlatesHelp') %></small>
                          </span>
                        </label>
                      </div>
                    </section>

                    <div class="request-profile-application-form__quotas">
                      <section class="request-profile-quota-card shell-card" data-request-profile-quotas>
                        <div class="request-profile-quota-card__head">
                          <h2><%= t('requestProfiles.sections.passTitle') %></h2>
                        </div>

                        <% if (passCategories.length) { %>
                          <div class="request-profile-quota-list">
                            <% passCategories.forEach((category) => { %>
                              <label class="request-profile-quota-row">
                                <span class="request-profile-quota-row__copy">
                                  <span class="request-profile-quota-row__title"><%= category.name %></span>
                                  <span class="request-profile-quota-row__description"><%= category.description || t('common.noDescription') %></span>
                                </span>
                                <input
                                  type="number"
                                  min="0"
                                  step="1"
                                  name="passQuota[category_<%= category.id %>]"
                                  class="field-input request-profile-quota-input"
                                  data-request-profile-quota-input
                                  value="<%= application.requestedPassQuotaMap[Number(category.id)] || 0 %>"
                                />
                              </label>
                            <% }) %>
                          </div>
                        <% } else { %>
                          <p class="request-profile-quota-card__empty"><%= t('requestProfiles.noPassTypes') %></p>
                        <% } %>
                      </section>

                      <section class="request-profile-quota-card shell-card" data-request-profile-quotas>
                        <div class="request-profile-quota-card__head">
                          <h2><%= t('requestProfiles.sections.wristbandTitle') %></h2>
                        </div>

                        <% if (wristbandCategories.length) { %>
                          <div class="request-profile-quota-list">
                            <% wristbandCategories.forEach((category) => { %>
                              <label class="request-profile-quota-row">
                                <span class="request-profile-quota-row__copy">
                                  <span class="request-profile-quota-row__title"><%= category.name %></span>
                                  <span class="request-profile-quota-row__description"><%= category.description || t('common.noDescription') %></span>
                                </span>
                                <input
                                  type="number"
                                  min="0"
                                  step="1"
                                  name="wristbandQuota[category_<%= category.id %>]"
                                  class="field-input request-profile-quota-input"
                                  data-request-profile-quota-input
                                  value="<%= application.requestedWristbandQuotaMap[Number(category.id)] || 0 %>"
                                />
                              </label>
                            <% }) %>
                          </div>
                        <% } else { %>
                          <p class="request-profile-quota-card__empty"><%= t('requestProfiles.noWristbandTypes') %></p>
                        <% } %>
                      </section>
                    </div>

                    <div class="request-profile-application-actions">
                      <button type="submit" class="btn-primary"><%= t('requestProfileApplications.approveEdited') %></button>
                    </div>
                  </form>
                </details>
              </div>
            <% } %>
          </article>
        <% }) %>
      </div>
    <% } %>
  </section>
</section>
