<%
  const submitAction = typeof checkAction === 'string' && checkAction ? checkAction : '/check';
  const publicVehicleCheckMode = Boolean(isPublicVehicleCheck);
  const hasCheckResult = Boolean(checkResult);
  const resultDirection = hasCheckResult
    ? (checkResult.direction === 'exit' ? 'exit' : checkResult.direction === 'check' ? 'check' : 'entry')
    : '';
  const resultToneClass = hasCheckResult
    ? (checkResult.allowed === false ? ' is-denied' : ` is-${resultDirection}`)
    : '';
  const resultPlate = hasCheckResult ? (checkResult.request?.vehiclePlate || checkResult.checkedPlate || '') : '';
  const resultMessage = hasCheckResult ? (checkResult.message || '') : '';
  const resultMessageDetails = hasCheckResult
    && checkResult.messageDetails
    && Array.isArray(checkResult.messageDetails.groups)
    && checkResult.messageDetails.groups.length
      ? checkResult.messageDetails
      : null;
  const actionPermissions = typeof checkActionPermissions === 'object' && checkActionPermissions
    ? checkActionPermissions
    : { canCheck: true, canChangeStatus: true };
  const canSubmitCheck = actionPermissions.canCheck !== false;
  const canSubmitStatusChange = actionPermissions.canChangeStatus !== false;
  const gateCheckLinks = typeof vehicleCheckLinks !== 'undefined' && Array.isArray(vehicleCheckLinks)
    ? vehicleCheckLinks.filter((link) => link && link.url && Number(link.is_active ?? 1) !== 0)
    : [];
%>
<section
  class="check-screen"
  data-check-app
  data-check-result-hint="<%= t('check.resultHint') %>"
  data-check-recent-empty-label="<%= t('check.recentEmpty') %>"
  data-check-not-set="<%= t('common.notSet') %>"
  data-check-scanner-open-label="<%= t('check.scanner.open') %>"
  data-check-scanner-loading-label="<%= t('check.scanner.loading') %>"
  data-check-scanner-aim-label="<%= t('check.scanner.aim') %>"
  data-check-scanner-scanning-label="<%= t('check.scanner.scanning') %>"
  data-check-scanner-found-label="<%= t('check.scanner.found') %>"
  data-check-scanner-not-found-label="<%= t('check.scanner.notFound') %>"
  data-check-scanner-error-label="<%= t('check.scanner.error') %>"
  data-check-scanner-unsupported-label="<%= t('check.scanner.unsupported') %>"
>
  <% if (selectedEvent) { %>
    <header class="check-page-head">
      <p class="worldnic-eyebrow"><%= t('check.title') %></p>
      <h1><%= selectedEvent.name %></h1>
      <% if (selectedEvent.vehicle_check_link_name) { %>
        <p class="mt-2 inline-flex rounded-full bg-slate-100 px-3 py-1 text-sm font-bold text-slate-700"><%= selectedEvent.vehicle_check_link_name %></p>
      <% } %>
    </header>

    <div class="check-layout">
      <div class="shell-card check-form-card">
        <form action="<%= submitAction %>" method="POST" class="check-form" data-check-form>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <% if (!publicVehicleCheckMode) { %>
            <input type="hidden" name="eventId" value="<%= selectedEvent.id %>" />
          <% } %>

          <div class="check-form-status<%= hasCheckResult ? '' : ' hidden' %><%= hasCheckResult && checkResult.allowed === false ? ' is-denied' : '' %>" data-check-form-status>
            <span data-check-form-status-label><%= hasCheckResult ? (checkResult.statusLabel || '') : '' %></span>
            <strong data-check-form-status-plate><%= resultPlate %></strong>
          </div>

          <div class="check-plate-control">
            <label class="field-label" for="check-vehicle-plate"><%= t('check.vehiclePlate') %></label>
            <div class="check-plate-input-group">
              <input
                id="check-vehicle-plate"
                name="vehiclePlate"
                type="text"
                class="field-input check-vehicle-input"
                placeholder="<%= t('check.vehiclePlatePlaceholder') %>"
                value="<%= checkFormValues?.vehiclePlate || '' %>"
                autocomplete="off"
                autocapitalize="characters"
                autocorrect="off"
                spellcheck="false"
                enterkeyhint="go"
                maxlength="20"
                autofocus
                required
                data-check-vehicle-plate
              />
              <button
                type="button"
                class="check-camera-trigger"
                aria-label="<%= t('check.scanner.open') %>"
                title="<%= t('check.scanner.open') %>"
                data-check-scanner-open
              >
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                  <path d="M9 4.5 7.7 7H5.4A2.4 2.4 0 0 0 3 9.4v7.2A2.4 2.4 0 0 0 5.4 19h13.2a2.4 2.4 0 0 0 2.4-2.4V9.4A2.4 2.4 0 0 0 18.6 7h-2.3L15 4.5H9Z" />
                  <circle cx="12" cy="13" r="3.4" />
                </svg>
              </button>
            </div>
          </div>

          <div class="check-action-grid">
            <% if (canSubmitCheck) { %>
              <button
                type="submit"
                name="direction"
                value="check"
                class="check-action-button check-action-button--check"
                data-check-submit-button
              >
                <%= t('check.checkButton') %>
              </button>
            <% } %>
            <% if (canSubmitStatusChange) { %>
              <button
                type="submit"
                name="direction"
                value="entry"
                class="check-action-button check-action-button--entry"
                data-check-submit-button
              >
                <%= t('check.entryButton') %>
              </button>
              <button
                type="submit"
                name="direction"
                value="exit"
                class="check-action-button check-action-button--exit"
                data-check-submit-button
              >
                <%= t('check.exitButton') %>
              </button>
            <% } %>
          </div>

          <div class="check-gate-control">
            <label class="field-label" for="check-gate-name"><%= t('check.gateName') %></label>
            <input
              id="check-gate-name"
              name="gateName"
              type="text"
              class="field-input check-gate-input"
              placeholder="<%= t('check.gateNamePlaceholder') %>"
              value="<%= checkFormValues?.gateName || '' %>"
              data-check-gate-name
            />
          </div>

          <% if (!publicVehicleCheckMode && gateCheckLinks.length) { %>
            <div class="check-gate-links">
              <div class="check-gate-links__head">
                <span><%= t('event.vehicleCheckGateLinksTitle') %></span>
              </div>
              <div class="check-gate-links__list">
                <% gateCheckLinks.forEach((link) => { %>
                  <a
                    href="<%= link.url %>"
                    class="check-gate-link-button"
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    <span><%= link.name %></span>
                    <small><%= t('event.vehicleCheckGateLinkCode', { code: String(link.token || '').toUpperCase() }) %></small>
                  </a>
                <% }) %>
              </div>
            </div>
          <% } %>

          <p class="check-inline-feedback hidden" data-check-feedback></p>
        </form>
      </div>

      <div class="check-side-stack">
        <div
          class="shell-card check-result-card<%= resultToneClass %>"
          data-check-result-card
        >
          <p class="worldnic-eyebrow"><%= t('check.resultTitle') %></p>

          <div class="check-result-ready<%= hasCheckResult ? ' hidden' : '' %>" data-check-result-empty>
            <span><%= t('check.readyStatus') %></span>
            <strong><%= t('check.vehiclePlate') %></strong>
          </div>

          <div class="check-result-content<%= hasCheckResult ? '' : ' hidden' %>" data-check-result-content>
            <div class="check-result-hero">
              <span class="check-status-badge" data-check-result-status>
                <%= hasCheckResult ? (checkResult.statusLabel || '') : '' %>
              </span>
              <strong data-check-result-plate><%= resultPlate %></strong>
              <p data-check-result-title><%= hasCheckResult ? (checkResult.directionTitle || '') : '' %></p>
            </div>

            <div class="check-result-message<%= resultMessageDetails ? ' check-result-message--structured' : '' %><%= (resultMessage || resultMessageDetails) ? '' : ' hidden' %>" data-check-result-message>
              <% if (resultMessageDetails) { %>
                <% if (resultMessageDetails.title) { %>
                  <p class="check-result-message__title"><%= resultMessageDetails.title %></p>
                <% } %>
                <div class="check-result-message__list">
                  <% resultMessageDetails.groups.forEach((group) => { %>
                    <div class="check-result-message__item">
                      <span><%= group.label %></span>
                      <ul>
                        <% group.values.forEach((value) => { %>
                          <li><%= value %></li>
                        <% }) %>
                      </ul>
                    </div>
                  <% }) %>
                </div>
              <% } else { %>
                <%= resultMessage %>
              <% } %>
            </div>

            <div class="check-result-detail-grid">
              <div class="check-result-detail">
                <span><%= t('check.resultPerson') %></span>
                <strong data-check-result-person><%= hasCheckResult ? (checkResult.request?.fullName || t('common.notSet')) : '' %></strong>
              </div>
              <div class="check-result-detail">
                <span><%= t('check.resultCompany') %></span>
                <strong data-check-result-company><%= hasCheckResult ? (checkResult.request?.companyName || t('common.notSet')) : '' %></strong>
              </div>
              <div class="check-result-detail">
                <span><%= t('check.resultType') %></span>
                <strong data-check-result-type><%= hasCheckResult ? (checkResult.request?.categoryName || t('common.notSet')) : '' %></strong>
              </div>
              <div class="check-result-detail">
                <span><%= t('check.resultPresence') %></span>
                <strong data-check-result-presence><%= hasCheckResult ? (checkResult.currentPresenceLabel || t('common.notSet')) : '' %></strong>
              </div>
              <div class="check-result-detail check-result-detail--wide">
                <span><%= t('check.resultPerformedAt') %></span>
                <strong data-check-result-performed-at><%= hasCheckResult ? (checkResult.performedAtLabel || t('common.notSet')) : '' %></strong>
              </div>
            </div>

            <div
              class="check-result-note<%= hasCheckResult && checkResult.alreadyEnteredMessage ? '' : ' hidden' %>"
              data-check-result-note
            >
              <%= hasCheckResult ? (checkResult.alreadyEnteredMessage || '') : '' %>
            </div>
          </div>
        </div>

        <div class="shell-card check-recent-card">
          <div class="check-recent-head">
            <p class="worldnic-eyebrow"><%= t('check.recentTitle') %></p>
          </div>

          <p class="check-recent-empty<%= recentMovements.length ? ' hidden' : '' %>" data-check-recent-empty>
            <%= t('check.recentEmpty') %>
          </p>

          <div class="check-recent-list<%= recentMovements.length ? '' : ' hidden' %>" data-check-recent-list>
            <% recentMovements.forEach((movement) => { %>
              <div class="check-recent-item">
                <div>
                  <p><%= movement.vehicle_plate %> · <%= movement.full_name %></p>
                  <span>
                    <%= t('check.recentMeta', {
                      direction: t(movement.direction === 'exit' ? 'check.direction.exit' : 'check.direction.entry'),
                      time: helpers.formatDateTime(movement.created_at),
                    }) %>
                  </span>
                  <% if (movement.company_name || movement.category_name || movement.gate_name) { %>
                    <small><%= [movement.company_name, movement.category_name, movement.gate_name].filter(Boolean).join(' · ') %></small>
                  <% } %>
                </div>

                <span class="check-recent-pill <%= movement.direction === 'exit' ? 'is-exit' : 'is-entry' %>">
                  <%= t(movement.direction === 'exit' ? 'check.direction.exit' : 'check.direction.entry') %>
                </span>
              </div>
            <% }) %>
          </div>
        </div>
      </div>
    </div>

    <div class="check-scanner-modal hidden" data-check-scanner-modal aria-hidden="true" role="dialog" aria-modal="true" aria-label="<%= t('check.scanner.title') %>">
      <div class="check-scanner-backdrop" data-check-scanner-close></div>
      <div class="check-scanner-panel">
        <div class="check-scanner-head">
          <div>
            <p class="worldnic-eyebrow"><%= t('check.scanner.eyebrow') %></p>
            <h2><%= t('check.scanner.title') %></h2>
          </div>
          <button type="button" class="check-scanner-close" aria-label="<%= t('check.scanner.close') %>" title="<%= t('check.scanner.close') %>" data-check-scanner-close>×</button>
        </div>

        <div class="check-scanner-viewport" data-check-scanner-viewport>
          <video autoplay muted playsinline data-check-scanner-video></video>
          <canvas data-check-scanner-canvas hidden></canvas>
          <div class="check-scanner-target" data-check-scanner-frame>
            <span data-check-scanner-candidate></span>
          </div>
        </div>

        <p class="check-scanner-status" data-check-scanner-status><%= t('check.scanner.aim') %></p>
        <button type="button" class="check-scanner-accept hidden" data-check-scanner-accept>
          <%= t('check.scanner.acceptCandidate') %>
        </button>
      </div>
    </div>
  <% } %>
</section>
