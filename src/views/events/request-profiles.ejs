<section class="request-profile-page request-profile-page--list space-y-6">
  <section class="shell-card request-profile-table-card">
    <div class="request-profile-table-card__head">
      <div>
        <p class="request-profile-table-card__eyebrow"><%= t('requestProfiles.nav.list') %></p>
        <h1><%= t('requestProfiles.listTitle') %></h1>
        <p><%= t('requestProfiles.listDescription') %></p>
      </div>

      <div class="request-profile-table-card__actions">
        <a href="#profile-applications" class="btn-secondary">
          <span><%= t('requestProfileApplications.adminButton', { count: pendingApplicationCount || 0 }) %></span>
        </a>

        <div class="request-profile-application-link-group" role="group" aria-label="<%= t('requestProfileApplications.publicLinkActions') %>">
          <a href="<%= profileApplicationUrl %>" target="_blank" rel="noreferrer" class="btn-secondary request-profile-application-link-group__open">
            <span><%= t('requestProfileApplications.openPublicLink') %></span>
          </a>

          <button
            type="button"
            class="btn-secondary request-profile-application-link-group__copy"
            data-copy-text="<%= profileApplicationUrl %>"
            data-copy-success-message="<%= t('requestProfileApplications.copySuccess') %>"
            title="<%= t('requestProfileApplications.copyPublicLink') %>"
            aria-label="<%= t('requestProfileApplications.copyPublicLink') %>"
          >
            <svg viewBox="0 0 20 20" aria-hidden="true">
              <path d="M7 3.5A2.5 2.5 0 0 1 9.5 1h6A2.5 2.5 0 0 1 18 3.5v6A2.5 2.5 0 0 1 15.5 12h-6A2.5 2.5 0 0 1 7 9.5zM4.5 6A2.5 2.5 0 0 0 2 8.5v6A2.5 2.5 0 0 0 4.5 17h6A2.5 2.5 0 0 0 13 14.5V14" />
            </svg>
          </button>
        </div>

        <div class="request-profile-search">
          <svg viewBox="0 0 20 20" aria-hidden="true">
            <path d="M8.5 3a5.5 5.5 0 1 1 0 11 5.5 5.5 0 0 1 0-11Zm0 1.6a3.9 3.9 0 1 0 0 7.8 3.9 3.9 0 0 0 0-7.8Zm5.38 8.64 3.02 3.02-1.13 1.13-3.02-3.02z" />
          </svg>
          <input
            type="search"
            class="field-input"
            placeholder="<%= t('requestProfiles.searchPlaceholder') %>"
            data-request-profile-search
          />
        </div>

        <a href="/events/<%= activeEvent.id %>/request-profiles/new" class="btn-primary">
          <img src="/public/design-assets/icons/feather/plus.svg" alt="" class="h-4 w-4 brightness-0 invert" />
          <span><%= t('requestProfiles.createButton') %></span>
        </a>
      </div>
    </div>

    <div class="request-profile-table-scroll">
      <table class="request-profile-table">
        <thead>
          <tr>
            <th><%= t('requestProfiles.table.profile') %></th>
            <th><%= t('requestProfiles.table.code') %></th>
            <th><%= t('requestProfiles.table.wristbands') %></th>
            <th><%= t('requestProfiles.table.passes') %></th>
            <th><%= t('requestProfiles.table.link') %></th>
            <th><%= t('requestProfiles.table.status') %></th>
            <th><%= t('requestProfiles.table.actions') %></th>
          </tr>
        </thead>
        <tbody data-request-profile-table-body>
          <% if (!profiles.length) { %>
            <tr data-request-profile-empty-row>
              <td colspan="7">
                <div class="request-profile-empty"><%= t('requestProfiles.none') %></div>
              </td>
            </tr>
          <% } %>

          <% profiles.forEach((profile) => { %>
            <tr
              data-request-profile-row
              data-search-index="<%= [profile.name, profile.access_code, profile.notes || '', profile.invite_url, profile.is_unlimited_quota ? t('requestProfiles.unlimited') : `${profile.wristbandTotals.used}/${profile.wristbandTotals.quota}`, profile.is_unlimited_quota ? t('requestProfiles.unlimited') : `${profile.passTotals.used}/${profile.passTotals.quota}`, profile.is_active ? t('common.active') : t('common.inactive')].join(' ').toLowerCase() %>"
            >
              <td>
                <div class="request-profile-cell">
                  <p class="request-profile-cell__title"><%= profile.name %></p>
                  <p class="request-profile-cell__meta"><%= profile.notes || t('common.noDescription') %></p>
                </div>
              </td>
              <td>
                <div class="request-profile-code-pill"><%= profile.access_code || '----' %></div>
              </td>
              <td>
                <div class="request-profile-quota-metric">
                  <% if (profile.is_unlimited_quota) { %>
                    <strong><%= profile.wristbandTotals.used %></strong>
                    <span><%= t('requestProfiles.unlimited') %></span>
                  <% } else { %>
                    <strong><%= profile.wristbandTotals.used %>/<%= profile.wristbandTotals.quota %></strong>
                    <span><%= t('requestProfiles.remaining', { count: profile.wristbandTotals.remaining }) %></span>
                  <% } %>
                </div>
              </td>
              <td>
                <div class="request-profile-quota-metric">
                  <% if (profile.is_unlimited_quota) { %>
                    <strong><%= profile.passTotals.used %></strong>
                    <span><%= t('requestProfiles.unlimited') %></span>
                  <% } else { %>
                    <strong><%= profile.passTotals.used %>/<%= profile.passTotals.quota %></strong>
                    <span><%= t('requestProfiles.remaining', { count: profile.passTotals.remaining }) %></span>
                  <% } %>
                </div>
              </td>
              <td>
                <div class="request-profile-link-cell">
                  <a href="<%= profile.invite_url %>" target="_blank" rel="noreferrer"><%= `/p/${profile.access_code}` %></a>
                </div>
              </td>
              <td>
                <span class="status-<%= profile.is_active ? 'active' : 'archived' %>"><%= profile.is_active ? t('common.active') : t('common.inactive') %></span>
              </td>
              <td>
                <div class="request-profile-actions">
                  <a
                    href="/events/<%= activeEvent.id %>/request-profiles/<%= profile.id %>/edit"
                    class="table-icon-button"
                    title="<%= t('requestProfiles.editProfile') %>"
                  >
                    <svg viewBox="0 0 20 20" aria-hidden="true">
                      <path d="M13.85 2.85a1.8 1.8 0 0 1 2.55 2.55l-8.1 8.1-3.38.83.84-3.38zm1.42 1.13-1.7-1.7" />
                    </svg>
                  </a>

                  <button
                    type="button"
                    class="table-icon-button"
                    data-copy-text="<%= profile.invite_url %>"
                    data-copy-success-message="<%= t('requestProfiles.copySuccess') %>"
                    title="<%= t('requestProfiles.copyInviteLink') %>"
                  >
                    <svg viewBox="0 0 20 20" aria-hidden="true">
                      <path d="M7 3.5A2.5 2.5 0 0 1 9.5 1h6A2.5 2.5 0 0 1 18 3.5v6A2.5 2.5 0 0 1 15.5 12h-6A2.5 2.5 0 0 1 7 9.5zM4.5 6A2.5 2.5 0 0 0 2 8.5v6A2.5 2.5 0 0 0 4.5 17h6A2.5 2.5 0 0 0 13 14.5V14" />
                    </svg>
                  </button>

                  <a
                    href="<%= profile.invite_url %>"
                    target="_blank"
                    rel="noreferrer"
                    class="table-icon-button"
                    title="<%= t('requestProfiles.openInviteLink') %>"
                  >
                    <svg viewBox="0 0 20 20" aria-hidden="true">
                      <path d="M11 3h6v6M10 10l7-7M16 11v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h4" />
                    </svg>
                  </a>
                </div>
              </td>
            </tr>
          <% }) %>

          <tr class="hidden" data-request-profile-empty-row>
            <td colspan="7">
              <div class="request-profile-empty"><%= t('requestProfiles.emptySearch') %></div>
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>

  <section id="profile-applications" class="shell-card request-profile-table-card request-profile-applications-card">
    <div class="request-profile-table-card__head">
      <div>
        <p class="request-profile-table-card__eyebrow"><%= t('requestProfileApplications.adminEyebrow') %></p>
        <h2><%= t('requestProfileApplications.adminTitle', { count: pendingApplicationCount || 0 }) %></h2>
        <p><%= t('requestProfileApplications.adminDescription') %></p>
      </div>
    </div>

    <% if (!profileApplications.length) { %>
      <div class="request-profile-applications-empty">
        <%= t('requestProfileApplications.empty') %>
      </div>
    <% } else { %>
      <div class="request-profile-application-list">
        <% profileApplications.forEach((application) => { %>
          <article class="request-profile-application-card request-profile-application-card--<%= application.status %>">
            <div class="request-profile-application-card__head">
              <div>
                <span class="request-profile-application-status request-profile-application-status--<%= application.status %>">
                  <%= t(`requestProfileApplications.status.${application.status}`) %>
                </span>
                <h3><%= application.profile_name %></h3>
                <p>
                  <%= application.contact_email %>
                  <% if (application.contact_phone) { %>
                    · <%= application.contact_phone %>
                  <% } %>
                </p>
                <p><%= t('requestProfileApplications.submittedAt', { time: helpers.formatDateTime(application.created_at) }) %></p>
              </div>

              <% if (application.approved_access_code) { %>
                <div class="request-profile-code-pill"><%= application.approved_access_code %></div>
              <% } %>
            </div>

            <% if (application.notes) { %>
              <p class="request-profile-application-card__notes"><%= application.notes %></p>
            <% } %>

            <% if (application.status === 'pending') { %>
              <form
                action="/events/<%= activeEvent.id %>/request-profile-applications/<%= application.id %>/approve"
                method="POST"
                class="request-profile-application-form"
                data-request-profile-form
                data-request-profile-quota-required-message="<%= t('service.requestProfileApplication.quotaRequired') %>"
              >
                <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

                <div class="request-profile-application-form__quotas">
                  <section class="request-profile-quota-card shell-card" data-request-profile-quotas>
                    <div class="request-profile-quota-card__head">
                      <h2><%= t('requestProfiles.sections.passTitle') %></h2>
                    </div>

                    <% if (passCategories.length) { %>
                      <div class="request-profile-quota-list">
                        <% passCategories.forEach((category) => { %>
                          <label class="request-profile-quota-row">
                            <span class="request-profile-quota-row__copy">
                              <span class="request-profile-quota-row__title"><%= category.name %></span>
                              <span class="request-profile-quota-row__description"><%= category.description || t('common.noDescription') %></span>
                            </span>
                            <input
                              type="number"
                              min="0"
                              step="1"
                              name="passQuota[<%= category.id %>]"
                              class="field-input request-profile-quota-input"
                              data-request-profile-quota-input
                              value="<%= application.requestedPassQuotaMap[Number(category.id)] || 0 %>"
                            />
                          </label>
                        <% }) %>
                      </div>
                    <% } else { %>
                      <p class="request-profile-quota-card__empty"><%= t('requestProfiles.noPassTypes') %></p>
                    <% } %>
                  </section>

                  <section class="request-profile-quota-card shell-card" data-request-profile-quotas>
                    <div class="request-profile-quota-card__head">
                      <h2><%= t('requestProfiles.sections.wristbandTitle') %></h2>
                    </div>

                    <% if (wristbandCategories.length) { %>
                      <div class="request-profile-quota-list">
                        <% wristbandCategories.forEach((category) => { %>
                          <label class="request-profile-quota-row">
                            <span class="request-profile-quota-row__copy">
                              <span class="request-profile-quota-row__title"><%= category.name %></span>
                              <span class="request-profile-quota-row__description"><%= category.description || t('common.noDescription') %></span>
                            </span>
                            <input
                              type="number"
                              min="0"
                              step="1"
                              name="wristbandQuota[<%= category.id %>]"
                              class="field-input request-profile-quota-input"
                              data-request-profile-quota-input
                              value="<%= application.requestedWristbandQuotaMap[Number(category.id)] || 0 %>"
                            />
                          </label>
                        <% }) %>
                      </div>
                    <% } else { %>
                      <p class="request-profile-quota-card__empty"><%= t('requestProfiles.noWristbandTypes') %></p>
                    <% } %>
                  </section>
                </div>

                <div class="request-profile-application-actions">
                  <button type="submit" class="btn-primary"><%= t('requestProfileApplications.approve') %></button>
                </div>
              </form>

              <form
                action="/events/<%= activeEvent.id %>/request-profile-applications/<%= application.id %>/reject"
                method="POST"
                class="request-profile-application-reject"
              >
                <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                <input
                  type="text"
                  name="reason"
                  class="field-input"
                  placeholder="<%= t('requestProfileApplications.rejectReasonPlaceholder') %>"
                />
                <button type="submit" class="btn-secondary"><%= t('requestProfileApplications.reject') %></button>
              </form>
            <% } else { %>
              <div class="request-profile-application-summary">
                <div>
                  <strong><%= t('requestProfiles.sections.passTitle') %></strong>
                  <span>
                    <%= application.requestedPassSummary.length
                      ? application.requestedPassSummary.map((entry) => `${entry.categoryName}: ${entry.quota}`).join(', ')
                      : '0'
                    %>
                  </span>
                </div>
                <div>
                  <strong><%= t('requestProfiles.sections.wristbandTitle') %></strong>
                  <span>
                    <%= application.requestedWristbandSummary.length
                      ? application.requestedWristbandSummary.map((entry) => `${entry.categoryName}: ${entry.quota}`).join(', ')
                      : '0'
                    %>
                  </span>
                </div>
                <% if (application.rejection_reason) { %>
                  <div>
                    <strong><%= t('requestProfileApplications.rejectReason') %></strong>
                    <span><%= application.rejection_reason %></span>
                  </div>
                <% } %>
              </div>
            <% } %>
          </article>
        <% }) %>
      </div>
    <% } %>
  </section>
</section>
