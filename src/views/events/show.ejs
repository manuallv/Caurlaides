<%
  const vehicleGateApiAuthMode = activeEvent.vehicle_gate_api_auth_mode === 'none' ? 'none' : 'api_key';
  const vehicleGateApiKey = activeEvent.vehicle_gate_api_key || '';
  const vehicleGateApiMode = ['entry', 'exit'].includes(activeEvent.vehicle_gate_api_mode)
    ? activeEvent.vehicle_gate_api_mode
    : 'decision';
  const vehicleGateApiDedupeSeconds = Number(activeEvent.vehicle_gate_api_dedupe_seconds || 180);
  const vehicleCheckLinksList = Array.isArray(vehicleCheckLinks) ? vehicleCheckLinks : [];
  const vehicleCheckPassCategoryList = Array.isArray(vehicleCheckPassCategories) ? vehicleCheckPassCategories : [];
  const findVehicleCheckLinkCategory = (link, categoryId) => (Array.isArray(link.categories) ? link.categories : [])
    .find((entry) => Number(entry.pass_category_id) === Number(categoryId)) || null;
  const vehicleGateApiExampleDirection = vehicleGateApiMode === 'decision'
    ? null
    : 'entry';
  const vehicleCheckApiRequestExample = JSON.stringify({
    plate: 'AB-1234',
    normalized_plate: 'AB1234',
    seen_at: '2026-04-17T12:30:00+03:00',
    camera_name: 'Gate A',
    ...(vehicleGateApiMode === 'exit' ? { direction: 'entry' } : {}),
    confidence: 0.98,
    vehicle_confidence: 0.97,
  }, null, 2);
  const vehicleCheckApiSuccessExample = JSON.stringify({
    success: true,
    decision: 'success',
    allowed: true,
    reason: null,
    message: t('service.vehicleEntry.allowed'),
    checkedPlate: 'AB-1234',
    currentPresence: vehicleGateApiExampleDirection === 'exit' ? 'outside' : vehicleGateApiExampleDirection === 'entry' ? 'inside' : 'unknown',
    movement: {
      mode: vehicleGateApiMode,
      configuredMode: vehicleGateApiMode,
      direction: vehicleGateApiExampleDirection,
      recorded: vehicleGateApiExampleDirection !== null,
      deduplicated: false,
      autoSwitched: false,
      explicitDirection: vehicleGateApiMode === 'exit',
    },
    request: {
      id: 128,
      fullName: 'Janis Berzins',
      companyName: 'Acme Logistics',
      categoryName: 'VIP Parking',
      profileName: 'Partners',
      vehiclePlate: 'AB-1234',
      createdAt: '2026-04-17T09:30:00.000Z',
      enteredAt: null,
      lastEntryAt: '2026-04-17T11:00:00.000Z',
      lastExitAt: '2026-04-17T11:35:00.000Z',
    },
  }, null, 2);
  const vehicleCheckApiDeniedExample = JSON.stringify({
    success: true,
    decision: 'denied',
    allowed: false,
    reason: 'not_found',
    message: t('service.vehicleEntry.notFound'),
    checkedPlate: 'ZZ-9999',
    currentPresence: 'unknown',
    movement: {
      mode: vehicleGateApiMode,
      configuredMode: vehicleGateApiMode,
      direction: vehicleGateApiExampleDirection,
      recorded: false,
      deduplicated: false,
      autoSwitched: false,
      explicitDirection: vehicleGateApiMode === 'exit',
    },
    request: null,
  }, null, 2);
%>
<section class="space-y-6" data-event-dashboard-app>
  <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-5" data-live-section="event-dashboard-summary">
    <div class="metric-card">
      <p class="text-sm font-medium text-slate-500"><%= t('event.passRequests') %></p>
      <p class="mt-3 text-3xl font-extrabold text-slate-900"><%= summary.totalPassRequests %></p>
    </div>
    <div class="metric-card">
      <p class="text-sm font-medium text-slate-500"><%= t('event.wristbandRequests') %></p>
      <p class="mt-3 text-3xl font-extrabold text-slate-900"><%= summary.totalWristbandRequests %></p>
    </div>
    <div class="metric-card">
      <p class="text-sm font-medium text-slate-500"><%= t('event.passCategories') %></p>
      <p class="mt-3 text-3xl font-extrabold text-slate-900"><%= summary.totalPassCategories %></p>
    </div>
    <div class="metric-card">
      <p class="text-sm font-medium text-slate-500"><%= t('event.wristbandCategories') %></p>
      <p class="mt-3 text-3xl font-extrabold text-slate-900"><%= summary.totalWristbandCategories %></p>
    </div>
    <div class="metric-card">
      <p class="text-sm font-medium text-slate-500"><%= t('event.requestProfiles') %></p>
      <p class="mt-3 text-3xl font-extrabold text-slate-900"><%= summary.totalRequestProfiles %></p>
    </div>
  </div>

  <% if (canManage) { %>
    <div class="event-dashboard-tabs" role="tablist" aria-label="Event dashboard tabs">
      <button type="button" class="event-dashboard-tab is-active" data-event-dashboard-tab="summary" aria-pressed="true">
        <%= t('event.dashboardTabSummary') %>
      </button>
      <button type="button" class="event-dashboard-tab" data-event-dashboard-tab="link" aria-pressed="false">
        <%= t('event.dashboardTabLink') %>
      </button>
      <button type="button" class="event-dashboard-tab" data-event-dashboard-tab="api" aria-pressed="false">
        <%= t('event.dashboardTabApi') %>
      </button>
    </div>
  <% } %>

  <div class="event-dashboard-panel is-active" data-event-dashboard-panel="summary">
    <div class="grid gap-6 lg:grid-cols-[1.15fr_0.85fr]">
      <div class="space-y-6">
        <div class="shell-card overflow-hidden" data-live-section="event-dashboard-team">
          <div class="flex items-center justify-between border-b border-slate-200/80 px-5 py-5 sm:px-6">
            <div>
              <h2 class="text-xl font-bold text-slate-900"><%= t('event.recentActivity') %></h2>
              <p class="mt-1 text-sm text-slate-500"><%= t('event.recentActivityDescription') %></p>
            </div>
            <a href="/events/<%= activeEvent.id %>/activity" class="btn-secondary"><%= t('event.openFullLog') %></a>
          </div>
          <div class="px-5 py-5 sm:px-6">
            <% if (!recentActivity.length) { %>
              <p class="text-sm text-slate-500"><%= t('event.noActivity') %></p>
            <% } else { %>
              <div class="space-y-4">
                <% recentActivity.forEach((entry) => { %>
                  <div class="border-l-2 border-brand-200 pl-4">
                    <p class="text-sm font-semibold text-slate-900"><%= helpers.formatAuditMessage(entry) %></p>
                    <p class="mt-1 text-xs uppercase tracking-wide text-slate-400">
                      <%= entry.actor_name || t('audit.actor.system') %> · <%= helpers.formatDateTime(entry.created_at) %>
                    </p>
                  </div>
                <% }) %>
              </div>
            <% } %>
          </div>
        </div>
      </div>

      <div class="space-y-6">
        <div class="shell-card overflow-hidden">
          <div class="border-b border-slate-200/80 px-5 py-5 sm:px-6">
            <h2 class="text-xl font-bold text-slate-900"><%= t('event.quickActions') %></h2>
          </div>
          <div class="grid gap-3 px-5 py-5 sm:px-6">
            <a href="/events/<%= activeEvent.id %>/wristbands" class="btn-primary"><%= t('event.manageWristbands') %></a>
            <a href="/events/<%= activeEvent.id %>/passes" class="btn-secondary"><%= t('event.managePasses') %></a>
            <a href="/events/<%= activeEvent.id %>/passes/print" class="btn-secondary"><%= t('event.printPasses') %></a>
            <% if (canManage) { %>
              <a href="/events/<%= activeEvent.id %>/request-profiles" class="btn-secondary"><%= t('event.manageRequestProfiles') %></a>
              <a href="/events/<%= activeEvent.id %>/edit" class="btn-secondary"><%= t('event.editSettings') %></a>
            <% } %>
            <a href="/events/<%= activeEvent.id %>/activity" class="btn-secondary"><%= t('event.viewAuditHistory') %></a>
          </div>
        </div>

        <div class="shell-card overflow-hidden">
          <div class="border-b border-slate-200/80 px-5 py-5 sm:px-6">
            <h2 class="text-xl font-bold text-slate-900"><%= t('event.teamSnapshot') %></h2>
          </div>
          <div class="space-y-3 px-5 py-5 sm:px-6">
            <% members.slice(0, 5).forEach((member) => { %>
              <div class="flex items-center justify-between rounded-2xl border border-slate-200 px-4 py-3">
                <div>
                  <p class="text-sm font-semibold text-slate-900"><%= member.full_name %></p>
                  <p class="text-xs text-slate-500"><%= member.email %></p>
                </div>
                <span class="rounded-full bg-slate-100 px-2.5 py-1 text-xs font-semibold text-slate-600"><%= helpers.roleLabel(member.role) %></span>
              </div>
            <% }) %>
            <a href="/events/<%= activeEvent.id %>/members" class="btn-secondary w-full"><%= t('event.manageCollaborators') %></a>
          </div>
        </div>

        <div class="shell-card overflow-hidden" data-live-section="event-dashboard-activity">
          <div class="border-b border-slate-200/80 px-5 py-5 sm:px-6">
            <h2 class="text-xl font-bold text-slate-900"><%= t('event.operationalSummary') %></h2>
            <p class="mt-1 text-sm text-slate-500"><%= t('event.operationalSummaryDescription') %></p>
          </div>
          <div class="grid gap-4 px-5 py-5 sm:px-6 md:grid-cols-2">
            <div class="panel">
              <p class="text-xs font-semibold uppercase tracking-wide text-slate-400"><%= t('event.passDeadline') %></p>
              <p class="mt-2 text-sm font-semibold text-slate-900"><%= helpers.formatDateTime(activeEvent.pass_request_deadline) %></p>
            </div>
            <div class="panel">
              <p class="text-xs font-semibold uppercase tracking-wide text-slate-400"><%= t('event.wristbandDeadline') %></p>
              <p class="mt-2 text-sm font-semibold text-slate-900"><%= helpers.formatDateTime(activeEvent.wristband_request_deadline) %></p>
            </div>
            <div class="panel md:col-span-2">
              <p class="text-xs font-semibold uppercase tracking-wide text-slate-400"><%= t('event.descriptionLabel') %></p>
              <p class="mt-2 text-sm leading-6 text-slate-600"><%= activeEvent.description || t('common.noDescription') %></p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <% if (canManage) { %>
    <div class="event-dashboard-panel" data-event-dashboard-panel="link" hidden>
      <div class="event-dashboard-link-layout">
        <div class="shell-card overflow-hidden" id="vehicle-check-link" data-live-section="event-dashboard-vehicle-check-link">
          <div class="border-b border-slate-200/80 px-5 py-5 sm:px-6">
            <h2 class="text-xl font-bold text-slate-900"><%= t('event.vehicleCheckLinkTitle') %></h2>
            <p class="mt-1 text-sm text-slate-500"><%= t('event.vehicleCheckLinkDescription') %></p>
          </div>

          <div class="space-y-6 px-5 py-5 sm:px-6">
            <section class="rounded-[1.25rem] border border-slate-200/80 bg-white/80 p-4 shadow-sm">
              <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
                <div class="min-w-0 flex-1">
                  <h3 class="text-base font-bold text-slate-900"><%= t('event.vehicleCheckGeneralLinkTitle') %></h3>
                  <p class="mt-1 text-sm text-slate-500"><%= t('event.vehicleCheckGeneralLinkDescription') %></p>
                </div>

                <form action="/events/<%= activeEvent.id %>/vehicle-check-link" method="POST" class="shrink-0">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                  <button type="submit" class="<%= vehicleCheckLink ? 'btn-secondary' : 'btn-primary' %> w-full">
                    <%= t(vehicleCheckLink ? 'event.vehicleCheckLinkRegenerate' : 'event.vehicleCheckLinkGenerate') %>
                  </button>
                </form>
              </div>

              <% if (vehicleCheckLink) { %>
                <div class="mt-4">
                  <label class="field-label"><%= t('event.vehicleCheckLinkField') %></label>
                  <div class="event-dashboard-copy-field">
                    <input type="text" class="field-input" value="<%= vehicleCheckLink %>" readonly onclick="this.select()" />
                    <button
                      type="button"
                      class="event-dashboard-copy-field__button"
                      data-copy-text="<%= vehicleCheckLink %>"
                      data-copy-success-message="<%= t('event.vehicleCheckLinkCopied') %>"
                      title="<%= t('event.vehicleCheckLinkCopy') %>"
                      aria-label="<%= t('event.vehicleCheckLinkCopy') %>"
                    >
                      <svg viewBox="0 0 20 20" aria-hidden="true">
                        <path d="M7.5 3.5A2.5 2.5 0 0 1 10 1h5.5A2.5 2.5 0 0 1 18 3.5V9a2.5 2.5 0 0 1-2.5 2.5H10A2.5 2.5 0 0 1 7.5 9V3.5Z" />
                        <path d="M5.5 6.5H5A2.5 2.5 0 0 0 2.5 9v5.5A2.5 2.5 0 0 0 5 17h5.5A2.5 2.5 0 0 0 13 14.5V14" />
                      </svg>
                    </button>
                  </div>
                  <div class="mt-3 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
                    <p class="text-xs text-slate-500">
                      <%= t('event.vehicleCheckLinkGeneratedAt', {
                        time: helpers.formatDateTime(activeEvent.vehicle_check_token_created_at),
                      }) %>
                    </p>
                    <a href="<%= vehicleCheckLink %>" target="_blank" rel="noreferrer" class="btn-secondary">
                      <%= t('event.vehicleCheckLinkOpen') %>
                    </a>
                  </div>
                </div>
              <% } else { %>
                <p class="mt-4 text-sm text-slate-500"><%= t('event.vehicleCheckLinkEmpty') %></p>
              <% } %>
            </section>

            <form action="/events/<%= activeEvent.id %>/vehicle-check-links" method="POST" class="rounded-[1.25rem] border border-brand-100 bg-brand-50/50 p-4 shadow-sm">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
              <div class="grid gap-4 lg:grid-cols-[minmax(0,0.95fr)_minmax(0,1.45fr)_auto] lg:items-end">
                <div>
                  <label class="field-label" for="vehicle-check-link-name-new"><%= t('event.vehicleCheckGateLinkName') %></label>
                  <input
                    id="vehicle-check-link-name-new"
                    name="name"
                    type="text"
                    class="field-input"
                    placeholder="<%= t('event.vehicleCheckGateLinkNamePlaceholder') %>"
                    maxlength="120"
                    required
                  />
                </div>

                <div>
                  <p class="field-label"><%= t('event.vehicleCheckGateLinkCategories') %></p>
                  <% if (vehicleCheckPassCategoryList.length) { %>
                    <div class="grid grid-cols-[minmax(0,1fr)_5.75rem_5.75rem] gap-2 px-2 text-xs font-bold uppercase tracking-wide text-slate-400">
                      <span><%= t('event.vehicleCheckGateLinkCategory') %></span>
                      <span class="text-center"><%= t('event.vehicleCheckCanCheck') %></span>
                      <span class="text-center"><%= t('event.vehicleCheckCanEnter') %></span>
                    </div>
                    <div class="mt-2 space-y-2">
                      <% vehicleCheckPassCategoryList.forEach((category) => { %>
                        <div class="grid grid-cols-[minmax(0,1fr)_5.75rem_5.75rem] items-center gap-2 rounded-2xl border border-slate-200 bg-white/90 px-3 py-2">
                          <span class="min-w-0 truncate text-sm font-semibold text-slate-800"><%= category.name %></span>
                          <label class="flex justify-center" title="<%= t('event.vehicleCheckCanCheck') %>">
                            <input type="checkbox" name="canCheckCategoryIds" value="<%= category.id %>" checked />
                          </label>
                          <label class="flex justify-center" title="<%= t('event.vehicleCheckCanEnter') %>">
                            <input type="checkbox" name="canEnterCategoryIds" value="<%= category.id %>" checked />
                          </label>
                        </div>
                      <% }) %>
                    </div>
                  <% } else { %>
                    <p class="text-sm text-slate-500"><%= t('event.vehicleCheckNoPassCategories') %></p>
                  <% } %>
                </div>

                <button type="submit" class="btn-primary" <%= vehicleCheckPassCategoryList.length ? '' : 'disabled' %>>
                  <%= t('event.vehicleCheckGateLinkCreate') %>
                </button>
              </div>
            </form>

            <section class="space-y-3">
              <div>
                <h3 class="text-base font-bold text-slate-900"><%= t('event.vehicleCheckGateLinksTitle') %></h3>
                <p class="mt-1 text-sm text-slate-500"><%= t('event.vehicleCheckGateLinksDescription') %></p>
              </div>

              <% if (vehicleCheckLinksList.length) { %>
                <div class="space-y-4">
                  <% vehicleCheckLinksList.forEach((link) => { %>
                    <div class="rounded-[1.25rem] border border-slate-200/80 bg-white/90 p-4 shadow-sm">
                      <div class="flex flex-col gap-3 lg:flex-row lg:items-start lg:justify-between">
                        <div class="min-w-0">
                          <h4 class="text-base font-bold text-slate-900"><%= link.name %></h4>
                          <p class="mt-1 text-xs uppercase tracking-wide text-slate-400">
                            <%= t('event.vehicleCheckGateLinkCode', { code: link.token }) %>
                          </p>
                        </div>
                        <div class="flex flex-wrap gap-2">
                          <a href="<%= link.url %>" target="_blank" rel="noreferrer" class="btn-secondary">
                            <%= t('event.vehicleCheckLinkOpen') %>
                          </a>
                          <form action="/events/<%= activeEvent.id %>/vehicle-check-links/<%= link.id %>/regenerate" method="POST">
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                            <button type="submit" class="btn-secondary"><%= t('event.vehicleCheckLinkRegenerate') %></button>
                          </form>
                          <form action="/events/<%= activeEvent.id %>/vehicle-check-links/<%= link.id %>?_method=DELETE" method="POST" onsubmit="return confirm('<%= t('common.confirmDelete') %>')">
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                            <button type="submit" class="btn-danger"><%= t('event.vehicleCheckGateLinkDelete') %></button>
                          </form>
                        </div>
                      </div>

                      <div class="mt-4">
                        <label class="field-label"><%= t('event.vehicleCheckLinkField') %></label>
                        <div class="event-dashboard-copy-field">
                          <input type="text" class="field-input" value="<%= link.url %>" readonly onclick="this.select()" />
                          <button
                            type="button"
                            class="event-dashboard-copy-field__button"
                            data-copy-text="<%= link.url %>"
                            data-copy-success-message="<%= t('event.vehicleCheckLinkCopied') %>"
                            title="<%= t('event.vehicleCheckLinkCopy') %>"
                            aria-label="<%= t('event.vehicleCheckLinkCopy') %>"
                          >
                            <svg viewBox="0 0 20 20" aria-hidden="true">
                              <path d="M7.5 3.5A2.5 2.5 0 0 1 10 1h5.5A2.5 2.5 0 0 1 18 3.5V9a2.5 2.5 0 0 1-2.5 2.5H10A2.5 2.5 0 0 1 7.5 9V3.5Z" />
                              <path d="M5.5 6.5H5A2.5 2.5 0 0 0 2.5 9v5.5A2.5 2.5 0 0 0 5 17h5.5A2.5 2.5 0 0 0 13 14.5V14" />
                            </svg>
                          </button>
                        </div>
                      </div>

                      <form action="/events/<%= activeEvent.id %>/vehicle-check-links/<%= link.id %>?_method=PUT" method="POST" class="mt-4 space-y-4">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                        <div>
                          <label class="field-label" for="vehicle-check-link-name-<%= link.id %>"><%= t('event.vehicleCheckGateLinkName') %></label>
                          <input
                            id="vehicle-check-link-name-<%= link.id %>"
                            name="name"
                            type="text"
                            class="field-input"
                            value="<%= link.name %>"
                            maxlength="120"
                            required
                          />
                        </div>

                        <div>
                          <div class="grid grid-cols-[minmax(0,1fr)_6rem_6rem] gap-2 px-2 text-xs font-bold uppercase tracking-wide text-slate-400">
                            <span><%= t('event.vehicleCheckGateLinkCategory') %></span>
                            <span class="text-center"><%= t('event.vehicleCheckCanCheck') %></span>
                            <span class="text-center"><%= t('event.vehicleCheckCanEnter') %></span>
                          </div>
                          <div class="mt-2 space-y-2">
                            <% vehicleCheckPassCategoryList.forEach((category) => {
                              const permission = findVehicleCheckLinkCategory(link, category.id);
                            %>
                              <div class="grid grid-cols-[minmax(0,1fr)_6rem_6rem] items-center gap-2 rounded-2xl border border-slate-200 bg-white px-3 py-2">
                                <span class="min-w-0 truncate text-sm font-semibold text-slate-800"><%= category.name %></span>
                                <label class="flex justify-center" title="<%= t('event.vehicleCheckCanCheck') %>">
                                  <input type="checkbox" name="canCheckCategoryIds" value="<%= category.id %>" <%= permission && Number(permission.can_check) === 1 ? 'checked' : '' %> />
                                </label>
                                <label class="flex justify-center" title="<%= t('event.vehicleCheckCanEnter') %>">
                                  <input type="checkbox" name="canEnterCategoryIds" value="<%= category.id %>" <%= permission && Number(permission.can_enter) === 1 ? 'checked' : '' %> />
                                </label>
                              </div>
                            <% }) %>
                          </div>
                        </div>

                        <button type="submit" class="btn-primary w-full sm:w-auto"><%= t('buttons.save') %></button>
                      </form>
                    </div>
                  <% }) %>
                </div>
              <% } else { %>
                <p class="rounded-[1.25rem] border border-dashed border-slate-300 bg-white/70 p-4 text-sm text-slate-500">
                  <%= t('event.vehicleCheckGateLinksEmpty') %>
                </p>
              <% } %>
            </section>
          </div>
        </div>
      </div>
    </div>

    <div class="event-dashboard-panel" data-event-dashboard-panel="api" hidden>
      <div class="event-dashboard-api-layout">
        <div class="shell-card overflow-hidden" id="vehicle-check-api">
          <div class="border-b border-slate-200/80 px-5 py-5 sm:px-6">
            <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
              <div>
                <h2 class="text-xl font-bold text-slate-900"><%= t('event.vehicleCheckApiTitle') %></h2>
                <p class="mt-1 text-sm text-slate-500"><%= t('event.vehicleCheckApiDescription') %></p>
              </div>
              <div class="flex flex-wrap gap-2">
                <span class="inline-flex items-center rounded-full px-3 py-1 text-xs font-semibold <%= vehicleGateApiAuthMode === 'none' ? 'bg-slate-100 text-slate-700' : vehicleCheckApiConfigured ? 'bg-emerald-100 text-emerald-700' : 'bg-amber-100 text-amber-700' %>">
                  <%= t(
                    vehicleGateApiAuthMode === 'none'
                      ? 'event.vehicleCheckApiStatusNoAuth'
                      : vehicleCheckApiConfigured
                        ? 'event.vehicleCheckApiStatusConfigured'
                        : 'event.vehicleCheckApiStatusMissing'
                  ) %>
                </span>
                <span class="inline-flex items-center rounded-full px-3 py-1 text-xs font-semibold <%= vehicleCheckApiUrl ? 'bg-slate-100 text-slate-700' : 'bg-slate-100 text-slate-500' %>">
                  <%= t(vehicleCheckApiUrl ? 'event.vehicleCheckApiEventScoped' : 'event.vehicleCheckApiNotGenerated') %>
                </span>
              </div>
            </div>
          </div>

          <div
            class="event-dashboard-api-body px-5 py-5 sm:px-6"
            data-vehicle-gate-api-preview
            data-vehicle-gate-api-allowed-message="<%= t('service.vehicleEntry.allowed') %>"
            data-vehicle-gate-api-not-found-message="<%= t('service.vehicleEntry.notFound') %>"
            data-vehicle-gate-api-mode-decision-label="<%= t('event.vehicleCheckApiModeDecision') %>"
            data-vehicle-gate-api-mode-entry-label="<%= t('event.vehicleCheckApiModeEntry') %>"
            data-vehicle-gate-api-mode-exit-label="<%= t('event.vehicleCheckApiModeExit') %>"
            data-vehicle-gate-api-mode-decision-hint="<%= t('event.vehicleCheckApiModeDecisionHint') %>"
            data-vehicle-gate-api-mode-entry-hint="<%= t('event.vehicleCheckApiModeEntryHint') %>"
            data-vehicle-gate-api-mode-exit-hint="<%= t('event.vehicleCheckApiModeExitHint') %>"
          >
            <section class="event-dashboard-api-section">
              <div class="event-dashboard-api-section__head">
                <h3><%= t('event.vehicleCheckApiAccessTitle') %></h3>
              </div>

              <div class="event-dashboard-api-grid">
                <div class="event-dashboard-api-card">
                  <p class="event-dashboard-api-card__label"><%= t('event.vehicleCheckApiEndpoint') %></p>
                  <div>
                    <input
                      type="text"
                      class="field-input font-mono text-[0.76rem]"
                      value="<%= vehicleCheckApiUrl || '' %>"
                      placeholder="<%= t('event.vehicleCheckApiEndpointEmpty') %>"
                      readonly
                      onclick="this.select()"
                    />
                  </div>
                  <% if (vehicleCheckApiUrl) { %>
                    <div class="event-dashboard-api-card__actions">
                      <form action="/events/<%= activeEvent.id %>/vehicle-gate-api/regenerate" method="POST">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                        <button type="submit" class="btn-secondary"><%= t('event.vehicleCheckApiRegenerate') %></button>
                      </form>
                    </div>
                  <% } %>
                </div>

                <div class="event-dashboard-api-card">
                  <p class="event-dashboard-api-card__label"><%= t('event.vehicleCheckApiAuth') %></p>
                  <% if (vehicleGateApiAuthMode === 'none') { %>
                    <div class="event-dashboard-api-card__value"><%= t('event.vehicleCheckApiNoAuthTitle') %></div>
                    <p class="text-xs leading-5 text-slate-500"><%= t('event.vehicleCheckApiNoAuthHint') %></p>
                  <% } else { %>
                    <div class="event-dashboard-api-card__value event-dashboard-api-card__value--mono">X-API-Key: <%= vehicleGateApiKey || 'YOUR_EVENT_API_KEY' %></div>
                    <div class="event-dashboard-api-card__value event-dashboard-api-card__value--mono">Authorization: Bearer <%= vehicleGateApiKey || 'YOUR_EVENT_API_KEY' %></div>
                    <p class="text-xs leading-5 text-slate-500"><%= t('event.vehicleCheckApiAuthHint') %></p>
                  <% } %>
                </div>

                <div class="event-dashboard-api-card">
                  <p class="event-dashboard-api-card__label">POST</p>
                  <div class="event-dashboard-api-card__value event-dashboard-api-card__value--mono">/api/external/events/{token}/vehicle-decisions</div>
                  <p class="text-xs leading-5 text-slate-500"><%= t('event.vehicleCheckApiConfigHint') %></p>
                </div>
              </div>
            </section>

            <section class="event-dashboard-api-section">
              <div class="event-dashboard-api-section__head">
                <h3><%= t('event.vehicleCheckApiSettingsTitle') %></h3>
              </div>

              <% if (vehicleGateApiAuthMode === 'api_key') { %>
                <div class="event-dashboard-api-card">
                  <p class="event-dashboard-api-card__label"><%= t('event.vehicleCheckApiKey') %></p>
                  <input
                    type="text"
                    class="field-input font-mono text-[0.8rem]"
                    value="<%= vehicleGateApiKey %>"
                    placeholder="<%= t('event.vehicleCheckApiKeyEmpty') %>"
                    readonly
                    onclick="this.select()"
                  />
                  <p class="text-xs leading-5 text-slate-500"><%= t('event.vehicleCheckApiKeyHint') %></p>
                </div>
              <% } %>

              <form action="/events/<%= activeEvent.id %>/vehicle-gate-api" method="POST" class="event-dashboard-api-form">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

                <div>
                  <label class="field-label" for="vehicle-gate-api-auth-mode"><%= t('event.vehicleCheckApiAuthMode') %></label>
                  <select id="vehicle-gate-api-auth-mode" name="authMode" class="field-input">
                    <option value="api_key" <%= vehicleGateApiAuthMode === 'api_key' ? 'selected' : '' %>><%= t('event.vehicleCheckApiAuthModeApiKey') %></option>
                    <option value="none" <%= vehicleGateApiAuthMode === 'none' ? 'selected' : '' %>><%= t('event.vehicleCheckApiAuthModeNone') %></option>
                  </select>
                </div>

                <div>
                  <label class="field-label" for="vehicle-gate-api-mode"><%= t('event.vehicleCheckApiMode') %></label>
                  <select id="vehicle-gate-api-mode" name="mode" class="field-input" data-vehicle-gate-api-mode-input>
                    <option value="decision" <%= vehicleGateApiMode === 'decision' ? 'selected' : '' %>><%= t('event.vehicleCheckApiModeDecision') %></option>
                    <option value="entry" <%= vehicleGateApiMode === 'entry' ? 'selected' : '' %>><%= t('event.vehicleCheckApiModeEntry') %></option>
                    <option value="exit" <%= vehicleGateApiMode === 'exit' ? 'selected' : '' %>><%= t('event.vehicleCheckApiModeExit') %></option>
                  </select>
                </div>

                <div>
                  <label class="field-label" for="vehicle-gate-api-dedupe"><%= t('event.vehicleCheckApiDedupe') %></label>
                  <input
                    id="vehicle-gate-api-dedupe"
                    name="dedupeSeconds"
                    type="number"
                    min="0"
                    max="3600"
                    step="1"
                    class="field-input"
                    value="<%= vehicleGateApiDedupeSeconds %>"
                  />
                </div>

                <div class="flex items-end">
                  <button type="submit" class="btn-primary w-full sm:w-auto">
                    <%= t(vehicleCheckApiUrl ? 'event.vehicleCheckApiSave' : 'event.vehicleCheckApiGenerate') %>
                  </button>
                </div>
              </form>

              <div class="event-dashboard-api-mode-helper" data-vehicle-gate-api-mode-helper>
                <p class="event-dashboard-api-mode-helper__label"><%= t('event.vehicleCheckApiModeHelperTitle') %></p>
                <strong class="event-dashboard-api-mode-helper__title" data-vehicle-gate-api-mode-helper-title>
                  <%= t(
                    vehicleGateApiMode === 'entry'
                      ? 'event.vehicleCheckApiModeEntry'
                      : vehicleGateApiMode === 'exit'
                        ? 'event.vehicleCheckApiModeExit'
                        : 'event.vehicleCheckApiModeDecision'
                  ) %>
                </strong>
                <p class="event-dashboard-api-mode-helper__body" data-vehicle-gate-api-mode-helper-body>
                  <%= t(
                    vehicleGateApiMode === 'entry'
                      ? 'event.vehicleCheckApiModeEntryHint'
                      : vehicleGateApiMode === 'exit'
                        ? 'event.vehicleCheckApiModeExitHint'
                        : 'event.vehicleCheckApiModeDecisionHint'
                  ) %>
                </p>
              </div>
            </section>

            <section class="event-dashboard-api-section">
              <div class="event-dashboard-api-section__head">
                <h3><%= t('event.vehicleCheckApiExamplesTitle') %></h3>
              </div>

              <div class="event-dashboard-api-examples">
                <div class="event-dashboard-api-code-card">
                  <p class="event-dashboard-api-card__label"><%= t('event.vehicleCheckApiRequest') %></p>
                  <pre data-vehicle-gate-api-request-example><%= vehicleCheckApiRequestExample %></pre>
                </div>

                <div class="event-dashboard-api-code-card">
                  <p class="event-dashboard-api-card__label"><%= t('event.vehicleCheckApiSuccess') %></p>
                  <pre data-vehicle-gate-api-success-example><%= vehicleCheckApiSuccessExample %></pre>
                </div>

                <div class="event-dashboard-api-code-card">
                  <p class="event-dashboard-api-card__label"><%= t('event.vehicleCheckApiDenied') %></p>
                  <pre data-vehicle-gate-api-denied-example><%= vehicleCheckApiDeniedExample %></pre>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  <% } %>
</section>
