<%
  const backgroundRotation = Number(template.backgroundRotation || 0);
  const normalizedBackgroundRotation = (((Math.round(backgroundRotation / 90) * 90) % 360) + 360) % 360;
  const templateOrientation = template.orientation === 'landscape' ? 'landscape' : 'portrait';
  const normalizeHexColor = (value, fallback = '#0f172a') => {
    const color = String(value || '').trim();
    return /^#[0-9a-f]{6}$/i.test(color) ? color.toLowerCase() : fallback;
  };
  const templateTextColor = normalizeHexColor(template.textColor || (template.fields || []).find((field) => field.textColor)?.textColor);
  const pageWidthMm = templateOrientation === 'landscape' ? 297 : 210;
  const pageHeightMm = templateOrientation === 'landscape' ? 210 : 297;
  const backgroundFrame = (() => {
    switch (normalizedBackgroundRotation) {
      case 90:
        return {
          left: '100%',
          top: '0%',
          width: `${(pageHeightMm / pageWidthMm) * 100}%`,
          height: `${(pageWidthMm / pageHeightMm) * 100}%`,
          rotation: '90deg',
        };
      case 180:
        return {
          left: '100%',
          top: '100%',
          width: '100%',
          height: '100%',
          rotation: '180deg',
        };
      case 270:
        return {
          left: '0%',
          top: '100%',
          width: `${(pageHeightMm / pageWidthMm) * 100}%`,
          height: `${(pageWidthMm / pageHeightMm) * 100}%`,
          rotation: '270deg',
        };
      default:
        return {
          left: '0%',
          top: '0%',
          width: '100%',
          height: '100%',
          rotation: '0deg',
        };
    }
  })();
  const passPrintState = JSON.stringify({
    canManage,
    template: {
      name: template.name || '',
      backgroundUrl: template.backgroundUrl || '',
      backgroundRotation: normalizedBackgroundRotation,
      orientation: templateOrientation,
      textColor: templateTextColor,
      fields: template.fields || [],
    },
    variables: variableDefinitions || [],
  });
%>

<section
  class="space-y-5"
  data-pass-print-app
  data-pass-print-can-manage="<%= canManage ? 'true' : 'false' %>"
  data-pass-print-state-script="pass-print-state"
  data-pass-print-empty-label="<%= t('passPrint.empty') %>"
  data-pass-print-selected-title="<%= t('passPrint.editor.selectedField') %>"
  data-pass-print-no-selection="<%= t('passPrint.editor.noSelection') %>"
  data-pass-print-preview-title="<%= t('passPrint.editor.previewTitle') %>"
  data-pass-print-remove-background-label="<%= t('passPrint.editor.removeBackground') %>"
  data-pass-print-restore-background-label="<%= t('passPrint.editor.restoreBackground') %>"
  data-pass-print-portrait-label="<%= t('passPrint.editor.orientation.portrait') %>"
  data-pass-print-landscape-label="<%= t('passPrint.editor.orientation.landscape') %>"
  data-pass-print-fullscreen-label="<%= t('passPrint.editor.fullscreen') %>"
  data-pass-print-exit-fullscreen-label="<%= t('passPrint.editor.exitFullscreen') %>"
>
  <div class="shell-card overflow-hidden">
    <div class="border-b border-slate-200/80 px-5 py-5 sm:px-6">
      <div class="pass-print-hero">
        <div class="pass-print-hero__copy">
          <p class="worldnic-eyebrow"><%= t('event.sidebar.autoPasses') %></p>
          <h1 class="mt-3 text-2xl font-bold text-slate-900"><%= t('passPrint.title') %></h1>
          <p class="mt-2 text-sm text-slate-500"><%= t('passPrint.description') %></p>

          <div class="pass-print-tabs mt-5">
            <button type="button" class="pass-print-tab is-active" data-pass-print-tab="editor"><%= t('passPrint.tabs.editor') %></button>
            <button type="button" class="pass-print-tab" data-pass-print-tab="print"><%= t('passPrint.tabs.print') %></button>
          </div>
        </div>

        <% if (!canManage) { %>
          <div class="rounded-2xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-900">
            <%= t('passPrint.readOnlyHint') %>
          </div>
        <% } else { %>
          <div class="pass-print-transfer">
            <div>
              <h2><%= t('passPrint.transfer.title') %></h2>
              <p><%= t('passPrint.transfer.description') %></p>
            </div>

            <form
              action="/events/<%= activeEvent.id %>/passes/print/template/import"
              method="POST"
              enctype="multipart/form-data"
              class="pass-print-transfer__form"
              data-pass-print-import-form
            >
              <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
              <input
                id="pass-print-template-file"
                name="templateFile"
                type="file"
                class="field-input pass-print-transfer__file"
                accept=".json,application/json"
                required
                aria-label="<%= t('passPrint.transfer.importFile') %>"
              />
              <button
                type="submit"
                class="pass-print-transfer__icon-button"
                title="<%= t('passPrint.transfer.import') %>"
                aria-label="<%= t('passPrint.transfer.import') %>"
              >
                <svg class="pass-print-toolbar__icon" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M12 21V9"></path>
                  <path d="m17 14-5-5-5 5"></path>
                  <path d="M5 3h14"></path>
                </svg>
              </button>
              <a
                href="/events/<%= activeEvent.id %>/passes/print/template/export"
                class="pass-print-transfer__icon-button"
                title="<%= t('passPrint.transfer.export') %>"
                aria-label="<%= t('passPrint.transfer.export') %>"
              >
                <svg class="pass-print-toolbar__icon" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M12 3v12"></path>
                  <path d="m7 10 5 5 5-5"></path>
                  <path d="M5 21h14"></path>
                </svg>
              </a>
            </form>
          </div>
        <% } %>
      </div>
    </div>

    <div class="px-5 py-5 sm:px-6">
      <div data-pass-print-panel="editor">
        <form
          action="/events/<%= activeEvent.id %>/passes/print/template"
          method="POST"
          enctype="multipart/form-data"
          class="pass-print-editor-form space-y-5"
          data-pass-print-form
          data-pass-print-fullscreen-target
        >
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <input type="hidden" name="templateFields" value="" data-pass-print-fields-input />
          <input type="hidden" name="backgroundRotation" value="<%= backgroundRotation %>" data-pass-print-background-rotation-input />

          <div class="pass-print-toolbar">
            <div class="pass-print-toolbar__main">
              <div>
                <label class="field-label" for="pass-print-template-name"><%= t('passPrint.editor.templateName') %></label>
                <input
                  id="pass-print-template-name"
                  name="templateName"
                  type="text"
                  class="field-input"
                  value="<%= template.name %>"
                  maxlength="160"
                  <%= canManage ? '' : 'disabled' %>
                />
              </div>

              <div>
                <label class="field-label" for="pass-print-template-orientation"><%= t('passPrint.editor.orientation') %></label>
                <select
                  id="pass-print-template-orientation"
                  name="templateOrientation"
                  class="field-input"
                  data-pass-print-template-orientation
                  <%= canManage ? '' : 'disabled' %>
                >
                  <option value="portrait" <%= templateOrientation === 'portrait' ? 'selected' : '' %>><%= t('passPrint.editor.orientation.portrait') %></option>
                  <option value="landscape" <%= templateOrientation === 'landscape' ? 'selected' : '' %>><%= t('passPrint.editor.orientation.landscape') %></option>
                </select>
              </div>

              <div>
                <label class="field-label" for="pass-print-template-text-color"><%= t('passPrint.editor.textColor') %></label>
                <input
                  id="pass-print-template-text-color"
                  type="color"
                  class="field-input pass-print-color-input"
                  value="<%= templateTextColor %>"
                  data-pass-print-template-text-color
                  <%= canManage ? '' : 'disabled' %>
                />
              </div>

              <div>
                <label class="field-label" for="pass-print-background-image"><%= t('passPrint.editor.backgroundImage') %></label>
                <input
                  id="pass-print-background-image"
                  name="backgroundImage"
                  type="file"
                  class="field-input"
                  accept="image/png,image/jpeg"
                  data-pass-print-background-input
                  <%= canManage ? '' : 'disabled' %>
                />
              </div>
            </div>

            <input type="hidden" name="removeBackground" value="0" data-pass-print-remove-background />

            <div class="pass-print-toolbar__actions">
              <button type="button" class="btn-secondary" data-pass-print-rotate-background <%= canManage ? '' : 'disabled' %>>
                <svg class="pass-print-toolbar__icon" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M21 12a9 9 0 1 1-3.1-6.8"></path>
                  <path d="M21 3v6h-6"></path>
                </svg>
                <span><%= t('passPrint.editor.rotateBackground90') %></span>
              </button>
              <span class="pass-print-toolbar__rotation-chip" data-pass-print-background-rotation-value><%= backgroundRotation %>°</span>
              <button type="button" class="btn-secondary" data-pass-print-remove-background-button <%= canManage ? '' : 'disabled' %>>
                <svg class="pass-print-toolbar__icon" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M3 6h18"></path>
                  <path d="M8 6V4h8v2"></path>
                  <path d="M19 6l-1 14H6L5 6"></path>
                  <path d="M10 11v5"></path>
                  <path d="M14 11v5"></path>
                </svg>
                <span data-pass-print-remove-background-label><%= t('passPrint.editor.removeBackground') %></span>
              </button>

              <% if (canManage) { %>
                <button
                  type="button"
                  class="btn-secondary pass-print-toolbar__preview"
                  data-pass-print-preview
                  data-pass-print-preview-url="/events/<%= activeEvent.id %>/passes/print/preview"
                >
                  <svg class="pass-print-toolbar__icon" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M1.5 12s3.8-6.5 10.5-6.5S22.5 12 22.5 12 18.7 18.5 12 18.5 1.5 12 1.5 12Z"></path>
                    <path d="M12 9a3 3 0 1 0 0 6 3 3 0 0 0 0-6Z"></path>
                  </svg>
                  <span><%= t('passPrint.editor.previewPdf') %></span>
                </button>
                <button type="submit" class="btn-primary pass-print-toolbar__save">
                  <svg class="pass-print-toolbar__icon" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2Z"></path>
                    <path d="M17 21v-8H7v8"></path>
                    <path d="M7 3v5h8"></path>
                  </svg>
                  <span><%= t('passPrint.editor.saveTemplate') %></span>
                </button>
              <% } %>
            </div>
          </div>

          <div class="pass-print-workspace">
            <div class="pass-print-workspace__stage">
              <div class="pass-print-stage-wrap">
                <div class="flex items-center justify-between gap-3">
                  <div>
                    <p class="worldnic-eyebrow"><%= t('passPrint.editor.previewLabel') %></p>
                    <h2 class="mt-2 text-lg font-bold text-slate-900"><%= t('passPrint.editor.previewTitle') %></h2>
                  </div>
                  <div class="pass-print-stage-actions">
                    <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold text-slate-600" data-pass-print-orientation-label>
                      <%= templateOrientation === 'landscape' ? t('passPrint.editor.orientation.landscape') : t('passPrint.editor.orientation.portrait') %>
                    </span>
                    <button
                      type="button"
                      class="pass-print-fullscreen-toggle"
                      data-pass-print-fullscreen-toggle
                      aria-label="<%= t('passPrint.editor.fullscreen') %>"
                      title="<%= t('passPrint.editor.fullscreen') %>"
                    >
                      <svg class="pass-print-fullscreen-icon pass-print-fullscreen-icon--enter" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M8 3H3v5"></path>
                        <path d="M3 3l7 7"></path>
                        <path d="M16 3h5v5"></path>
                        <path d="M21 3l-7 7"></path>
                        <path d="M8 21H3v-5"></path>
                        <path d="M3 21l7-7"></path>
                        <path d="M16 21h5v-5"></path>
                        <path d="M21 21l-7-7"></path>
                      </svg>
                      <svg class="pass-print-fullscreen-icon pass-print-fullscreen-icon--exit" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M10 3v7H3"></path>
                        <path d="M3 10l7-7"></path>
                        <path d="M14 3v7h7"></path>
                        <path d="M21 10l-7-7"></path>
                        <path d="M10 21v-7H3"></path>
                        <path d="M3 14l7 7"></path>
                        <path d="M14 21v-7h7"></path>
                        <path d="M21 14l-7 7"></path>
                      </svg>
                    </button>
                  </div>
                </div>

                <div class="pass-print-stage">
                  <div
                    class="pass-print-page pass-print-page--<%= templateOrientation %><%= template.backgroundUrl ? ' has-background' : '' %>"
                    data-pass-print-page
                  >
                    <div
                      class="pass-print-page__background<%= template.backgroundUrl ? ' is-active' : '' %>"
                      data-pass-print-background-layer
                      style="<%= template.backgroundUrl ? `background-image: url('${template.backgroundUrl}'); --pass-print-background-rotation:${backgroundFrame.rotation}; --pass-print-background-left:${backgroundFrame.left}; --pass-print-background-top:${backgroundFrame.top}; --pass-print-background-width:${backgroundFrame.width}; --pass-print-background-height:${backgroundFrame.height};` : '' %>"
                    ></div>
                    <div class="pass-print-page__grid"></div>
                    <div class="pass-print-page__fields" data-pass-print-field-layer></div>
                    <div class="pass-print-page__empty<%= template.fields.length ? ' hidden' : '' %>" data-pass-print-empty-state>
                      <strong><%= t('passPrint.empty') %></strong>
                      <span><%= t('passPrint.editor.dragHint') %></span>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <div class="pass-print-workspace__sidebar">
              <div class="pass-print-panel">
                <p class="worldnic-eyebrow"><%= t('passPrint.editor.variablesTitle') %></p>
                <h2 class="mt-2 text-lg font-bold text-slate-900"><%= t('passPrint.editor.variablesSubtitle') %></h2>
                <p class="mt-2 text-sm text-slate-500"><%= t('passPrint.editor.variablesDescription') %></p>

                <div class="mt-4 grid gap-3 sm:grid-cols-2 xl:grid-cols-1">
                  <% variableDefinitions.forEach((definition) => { %>
                    <button
                      type="button"
                      class="pass-print-variable-btn"
                      data-pass-print-add-field="<%= definition.type %>"
                      <%= canManage ? '' : 'disabled' %>
                    >
                      <span><%= definition.label %></span>
                      <img src="/public/design-assets/icons/feather/plus.svg" alt="" />
                    </button>
                  <% }) %>
                </div>
              </div>

              <div class="pass-print-panel">
                <p class="worldnic-eyebrow"><%= t('passPrint.editor.selectedField') %></p>
                <h2 class="mt-2 text-lg font-bold text-slate-900" data-pass-print-inspector-title><%= t('passPrint.editor.noSelection') %></h2>

                <div class="mt-4 space-y-4" data-pass-print-inspector>
                  <div>
                    <label class="field-label" for="pass-print-field-type"><%= t('passPrint.editor.variableType') %></label>
                    <select id="pass-print-field-type" class="field-input" data-pass-print-field-type <%= canManage ? '' : 'disabled' %>>
                      <% variableDefinitions.forEach((definition) => { %>
                        <option value="<%= definition.type %>"><%= definition.label %></option>
                      <% }) %>
                    </select>
                  </div>

                  <div>
                    <label class="field-label" for="pass-print-field-text"><%= t('passPrint.editor.fieldText') %></label>
                    <input
                      id="pass-print-field-text"
                      type="text"
                      maxlength="200"
                      class="field-input"
                      placeholder="<%= t('passPrint.editor.fieldTextPlaceholder') %>"
                      data-pass-print-field-text
                      <%= canManage ? '' : 'disabled' %>
                    />
                  </div>

                  <div class="pass-print-inspector-section">
                    <p class="worldnic-eyebrow"><%= t('passPrint.editor.variableStyle') %></p>
                    <div class="mt-3 grid gap-4 sm:grid-cols-2">
                      <div>
                        <label class="field-label" for="pass-print-field-variable-font-size"><%= t('passPrint.editor.variableFontSize') %></label>
                        <input
                          id="pass-print-field-variable-font-size"
                          type="number"
                          min="8"
                          max="96"
                          step="1"
                          class="field-input"
                          data-pass-print-field-variable-font-size
                          <%= canManage ? '' : 'disabled' %>
                        />
                      </div>

                      <div>
                        <label class="field-label" for="pass-print-field-variable-font-weight"><%= t('passPrint.editor.variableFontWeight') %></label>
                        <select id="pass-print-field-variable-font-weight" class="field-input" data-pass-print-field-variable-font-weight <%= canManage ? '' : 'disabled' %>>
                          <option value="400"><%= t('passPrint.editor.fontWeight.regular') %></option>
                          <option value="600"><%= t('passPrint.editor.fontWeight.semiBold') %></option>
                          <option value="700"><%= t('passPrint.editor.fontWeight.bold') %></option>
                          <option value="800"><%= t('passPrint.editor.fontWeight.extraBold') %></option>
                        </select>
                      </div>
                    </div>
                  </div>

                  <div class="pass-print-inspector-section">
                    <p class="worldnic-eyebrow"><%= t('passPrint.editor.prefixStyle') %></p>
                    <div class="mt-3 grid gap-4 sm:grid-cols-2">
                      <div>
                        <label class="field-label" for="pass-print-field-prefix-font-size"><%= t('passPrint.editor.prefixFontSize') %></label>
                        <input
                          id="pass-print-field-prefix-font-size"
                          type="number"
                          min="8"
                          max="96"
                          step="1"
                          class="field-input"
                          data-pass-print-field-prefix-font-size
                          <%= canManage ? '' : 'disabled' %>
                        />
                      </div>

                      <div>
                        <label class="field-label" for="pass-print-field-prefix-font-weight"><%= t('passPrint.editor.prefixFontWeight') %></label>
                        <select id="pass-print-field-prefix-font-weight" class="field-input" data-pass-print-field-prefix-font-weight <%= canManage ? '' : 'disabled' %>>
                          <option value="400"><%= t('passPrint.editor.fontWeight.regular') %></option>
                          <option value="600"><%= t('passPrint.editor.fontWeight.semiBold') %></option>
                          <option value="700"><%= t('passPrint.editor.fontWeight.bold') %></option>
                          <option value="800"><%= t('passPrint.editor.fontWeight.extraBold') %></option>
                        </select>
                      </div>
                    </div>
                  </div>

                  <div class="grid gap-4 sm:grid-cols-2">
                    <div>
                      <label class="field-label" for="pass-print-field-width"><%= t('passPrint.editor.fieldWidth') %></label>
                      <input
                        id="pass-print-field-width"
                        type="number"
                        min="8"
                        max="90"
                        step="1"
                        class="field-input"
                        data-pass-print-field-width
                        <%= canManage ? '' : 'disabled' %>
                      />
                    </div>

                    <div>
                      <label class="field-label" for="pass-print-field-text-align"><%= t('passPrint.editor.textAlign') %></label>
                      <select id="pass-print-field-text-align" class="field-input" data-pass-print-field-text-align <%= canManage ? '' : 'disabled' %>>
                        <option value="left"><%= t('passPrint.editor.align.left') %></option>
                        <option value="center"><%= t('passPrint.editor.align.center') %></option>
                        <option value="right"><%= t('passPrint.editor.align.right') %></option>
                      </select>
                    </div>
                  </div>

                  <div class="pass-print-inspector-section">
                    <p class="worldnic-eyebrow"><%= t('passPrint.editor.borderStyle') %></p>
                    <div class="mt-3 grid gap-4 sm:grid-cols-2">
                      <label class="pass-print-border-toggle" for="pass-print-field-border-enabled">
                        <input
                          id="pass-print-field-border-enabled"
                          type="checkbox"
                          data-pass-print-field-border-enabled
                          <%= canManage ? '' : 'disabled' %>
                        />
                        <span><%= t('passPrint.editor.borderEnabled') %></span>
                      </label>

                      <div>
                        <label class="field-label" for="pass-print-field-border-color"><%= t('passPrint.editor.borderColor') %></label>
                        <input
                          id="pass-print-field-border-color"
                          type="color"
                          class="field-input pass-print-color-input"
                          value="#0f172a"
                          data-pass-print-field-border-color
                          <%= canManage ? '' : 'disabled' %>
                        />
                      </div>
                    </div>
                  </div>

                  <div class="pass-print-inspector-metrics">
                    <div class="pass-print-inspector-metric">
                      <span class="pass-print-inspector-metric__label"><%= t('passPrint.editor.positionX') %></span>
                      <p class="pass-print-inspector-metric__value" data-pass-print-field-position-x>0%</p>
                    </div>
                    <div class="pass-print-inspector-metric">
                      <span class="pass-print-inspector-metric__label"><%= t('passPrint.editor.positionY') %></span>
                      <p class="pass-print-inspector-metric__value" data-pass-print-field-position-y>0%</p>
                    </div>
                    <div class="pass-print-inspector-metric">
                      <span class="pass-print-inspector-metric__label"><%= t('passPrint.editor.rotation') %></span>
                      <p class="pass-print-inspector-metric__value" data-pass-print-field-rotation>0°</p>
                    </div>
                  </div>

                  <div class="grid gap-3 sm:grid-cols-2">
                    <% if (canManage) { %>
                      <button type="button" class="btn-secondary w-full" data-pass-print-rotate-field><%= t('passPrint.editor.rotate90') %></button>
                      <button type="button" class="btn-secondary w-full" data-pass-print-remove-field><%= t('passPrint.editor.removeField') %></button>
                    <% } %>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </form>
      </div>

      <div class="hidden" data-pass-print-panel="print">
        <div class="pass-print-print-shell">
          <div class="pass-print-panel">
            <p class="worldnic-eyebrow"><%= t('passPrint.printTitle') %></p>
            <h2 class="mt-2 text-xl font-bold text-slate-900"><%= t('passPrint.printDescription') %></h2>

            <form action="/events/<%= activeEvent.id %>/passes/print/export" method="GET" class="mt-5 space-y-4">
              <div>
                <label class="field-label" for="pass-print-category-filter"><%= t('passPrint.printFilter') %></label>
                <select id="pass-print-category-filter" name="categoryId" class="field-input">
                  <option value=""><%= t('passPrint.printAllTypes') %></option>
                  <% categories.forEach((category) => { %>
                    <option value="<%= category.id %>" <%= Number(selectedCategoryId) === Number(category.id) ? 'selected' : '' %>>
                      <%= category.name %> (<%= category.total_requests %>)
                    </option>
                  <% }) %>
                </select>
              </div>

              <div class="flex flex-wrap gap-3">
                <button
                  type="submit"
                  name="disposition"
                  value="inline"
                  class="btn-primary"
                  formtarget="_blank"
                >
                  <%= t('passPrint.printOpen') %>
                </button>
                <button type="submit" name="disposition" value="attachment" class="btn-secondary">
                  <%= t('passPrint.printDownload') %>
                </button>
              </div>
            </form>
          </div>

          <div class="pass-print-panel">
            <p class="worldnic-eyebrow"><%= t('passPrint.printTypesList') %></p>
            <div class="mt-4 space-y-3">
              <% categories.forEach((category) => { %>
                <div class="pass-print-type-row">
                  <div>
                    <strong><%= category.name %></strong>
                    <% if (category.description) { %>
                      <span><%= category.description %></span>
                    <% } %>
                  </div>
                  <span><%= category.total_requests %></span>
                </div>
              <% }) %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="portal-modal pass-print-preview-modal" data-pass-print-preview-modal>
    <button type="button" class="portal-modal__backdrop" data-pass-print-preview-close></button>
    <div class="portal-modal__dialog portal-modal__dialog-wide shell-card" role="dialog" aria-modal="true" aria-labelledby="pass-print-preview-title">
      <div class="portal-modal__header">
        <div class="portal-modal__title-block">
          <p class="worldnic-eyebrow"><%= t('passPrint.editor.previewModalEyebrow') %></p>
          <h2 id="pass-print-preview-title"><%= t('passPrint.editor.previewModalTitle') %></h2>
        </div>
        <div class="pass-print-preview-modal__actions">
          <input
            type="number"
            min="1"
            step="1"
            inputmode="numeric"
            class="field-input pass-print-preview-modal__id-input"
            data-pass-print-preview-request-id
            placeholder="<%= t('passPrint.editor.previewRequestIdPlaceholder') %>"
            aria-label="<%= t('passPrint.editor.previewRequestId') %>"
          />
          <button
            type="button"
            class="table-icon-button"
            data-pass-print-preview-refresh
            data-pass-print-preview-url="/events/<%= activeEvent.id %>/passes/print/preview"
            title="<%= t('passPrint.editor.previewRefresh') %>"
            aria-label="<%= t('passPrint.editor.previewRefresh') %>"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M21 12a9 9 0 1 1-3-6.7"></path>
              <path d="M21 3v6h-6"></path>
            </svg>
          </button>
          <button type="button" class="table-icon-button" data-pass-print-preview-close aria-label="<%= t('passPrint.editor.previewClose') %>">
            <svg viewBox="0 0 20 20" aria-hidden="true">
              <path d="M5 5l10 10M15 5 5 15"></path>
            </svg>
          </button>
        </div>
      </div>

      <div class="pass-print-preview-modal__body">
        <div class="pass-print-preview-modal__loading" data-pass-print-preview-loading>
          <span class="portal-import-preview-loader__spinner"></span>
          <div>
            <strong><%= t('passPrint.editor.previewLoading') %></strong>
            <p><%= t('passPrint.editor.previewLoadingHint') %></p>
          </div>
        </div>
        <div class="pass-print-preview-modal__error hidden" data-pass-print-preview-error></div>
        <iframe class="pass-print-preview-modal__frame hidden" title="<%= t('passPrint.editor.previewModalTitle') %>" data-pass-print-preview-frame></iframe>
      </div>
    </div>
  </div>
</section>

<script id="pass-print-state" type="application/json"><%- passPrintState %></script>
